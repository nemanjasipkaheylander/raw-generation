    "prod_faq_HyVha7": {
      "type": "prod-faq",
      "blocks": {
        "text_i9dh3g": {
          "type": "text",
          "settings": {
            "faq_title": "Lorem ipsum",
            "faq_text": "Lorem ipsum dolor sit amet, consectetur adipiscing elit"
          }
        },
        "text_PizNgm": {
          "type": "text",
          "settings": {
            "faq_title": "Are these weight loss juices low-calorie and low sugar?",
            "faq_text": "Our in-house nutritionist believes that low-calorie fad diets are not the most effective approach to successful weight management long-term. Overly restrictive diets can often lead to frustration and setbacks. Lasting health and meaningful weight maintenance are more about choosing options with nutrient-dense ingredients, rather than counting calories, tracking fat grams, or limiting sugar intake. That being said, the juices in this cleanse were not designed to be low in calories, carbs, or natural fruit sugars. They provide your body with what it needs to thrive in the healthiest form possible…and the goal is to support sustainable weight management."
          }
        },
        "text_99JAKy": {
          "type": "text",
          "settings": {
            "faq_title": "Why are the juices frozen?",
            "faq_text": "We immediately flash-freeze all cold-pressed juices and smoothies. This is the only way to lock in the fresh flavor, raw nutrients, and enzymes, while still being able to deliver them to your door.Shipping juices frozen makes it super convenient for you. There’s no hefty prep time or messy clean-up. No juicer or blender is necessary for you to enjoy these juice recipes. All you have to do is thaw, sip, and experience the health benefits. Plus, if life gets in the way and you have to pause your cleanse, nothing goes to waste. The remaining bottles can stay in the freezer until you can start again."
          }
        }
      },
      "block_order": [
        "text_i9dh3g",
        "text_PizNgm",
        "text_99JAKy"
      ],
