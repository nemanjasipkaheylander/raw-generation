        "accordion_aTfeit": {
          "type": "accordion",
          "settings": {
            "title": "What's included?",
            "content": "<p>(3) Cold-pressed juices and (3) plant-based smoothies each cleanse day.<br/>3 days / 18 bottles  5 days / 30 bottles  7 days / 42 bottles  10 days / 60 bottles<br/><br/>(1) Cleanse Guide including:<br/><br/>• How to prepare for your cleanse. <br/>• What to do during your cleanse. <br/>• How to maintain your results and continue supporting your weight management goals after your cleanse is finished. <br/>• A list of cleanse-approved foods, including high-protein plants. <br/>• A cleanse-approved Hearty Vegetable Soup recipe.<br/><br/>Subscribe & Save customers will get everything above, PLUS:<br/><br/>•10% off every order. <br/>• Free shipping on every order. <br/>• A monthly virtual group consultation with our Chief Nutrition Officer to ask her all of your health, wellness, and weight management questions.  <br/>• Access to a private Facebook Group to get answers to your questions in between the monthly calls.</p>",
            "open_by_default": false
          }
        },
        "accordion_exzhPH": {
