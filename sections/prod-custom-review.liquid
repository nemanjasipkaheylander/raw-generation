<script>
document.addEventListener('DOMContentLoaded', function () {
  const swiperRev = new Swiper('.swiper-reviews', {
    direction: 'horizontal',
    loop: false,
    slidesPerView: 1,
    spaceBetween: 16,

    breakpoints: {
      768: {
        slidesPerView: 2.1,
        spaceBetween: 16,
      },
      1024: {
        slidesPerView: 2.1,
        spaceBetween: 16,
      },
    },
  });

  const prevBtnsRev = document.querySelectorAll('.review-button-prev');
  const nextBtnsRev = document.querySelectorAll('.review-button-next');

  function updateButtonsRev() {
    prevBtnsRev.forEach(btn => {
      btn.classList.toggle('swiper-button-disabled', swiperRev.isBeginning);
    });
    nextBtnsRev.forEach(btn => {
      btn.classList.toggle('swiper-button-disabled', swiperRev.isEnd);
    });
  }

  prevBtnsRev.forEach(btn => {
    btn.addEventListener('click', () => {
      swiperRev.slidePrev();
      updateButtonsRev();
    });
  });

  nextBtnsRev.forEach(btn => {
    btn.addEventListener('click', () => {
      swiperRev.slideNext();
      updateButtonsRev();
    });
  });

  // Inicijalno stanje
  updateButtonsRev();
});

</script>



{% comment %} <script src='{{ '' | asset_url }}' defer='defer'></script> {% endcomment %}

<style>
.custom-review__card {
    border-radius: 20px;
    padding: 16px;
    background: #f4f2f5;
    display: flex;
    gap: 16px;
    height: 100%;
}
.custom-review__autor {
    font-family: "Jost", sans-serif;
    font-weight: 600;
    font-size: 18px;
    line-height: 1.42;
    color: #000;
}
.swiper-reviews .swiper-slide {
  height: auto;
}
.swiper-nav-desk .review-button-next,
.swiper-nav-desk .review-button-prev {
  cursor: pointer;
}
.custom-review__verified {
    font-family: "Jost", sans-serif;
    font-weight: 300;
    font-size: 13px;
    line-height: 1.5;
    color: #0a393e;
}
.review-button-prev.swiper-button-disabled,
.review-button-next.swiper-button-disabled
 {
    filter: grayscale(1);
}
.custo-review__text {
    font-family: "Jost", sans-serif;
    font-weight: 400;
    font-size: 16px;
    line-height: 1.34;
    color: #413c38;
}

.custom-review__footer-text {
    font-family: "Jost", sans-serif;
    font-weight: 400;
    font-size: 13px;
    line-height: 1.34;
    color: #413c38;
}

figure.custom-review__footer-image {
    border-radius: 4px;
    width: 50px;
    height: 50px;
}

.custom-review__review-footer {
    display: flex;
    align-items: center;
    gap: 8px;
    justify-content: flex-end;
    margin-top: auto;
}

.custom-review__left-side {
    display: flex;
    flex-direction: column;
    gap: 24px;
    max-width: 290px;
}

.custom-review__image-container {
    border-radius: 8px;
    width: 240px;
    height: 280px;
}
.custom-review__verified-icon {
  display: flex;
  align-items: center;
  gap: 5px;
}
.custo-review__content {
    display: flex;
    flex-direction: column;
    gap: 24px;
}
.custom-review__header-card {
    display: flex;
    align-items: center;
    gap: 8px;
}

h2.custom-review__title {
    font-family: "Jost", sans-serif;
    font-weight: 400;
    font-size: 38px;
    line-height: 1.4;
    color: #000;
    text-align: center;
}

.custom-review__section-header {
    margin-bottom: 32px;
    display: flex;
    align-items: center;
    justify-content: space-between;
}

@media (max-width: 767px) {
  .custom-review__card {
    flex-direction: column;
}
.custom-review__image-container {
    width: 100%;
    height: 364px;
    margin-top: auto;
}
.custom-review__image-container figure {
    height: 100%;
    border-radius: 8px;
}
.custom-review__image-container figure img {
    border-radius: 8px;
}
.h2.custom-review__title {
  font-size: 30px
}
}
</style>

