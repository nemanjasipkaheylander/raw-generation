{{ 'how-work.css' | asset_url | stylesheet_tag }}

<style>
  .h-work-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
      padding-left: {{ section.settings.padding_left | times: 0.5 | round: 0 }}px;
      padding-right: {{ section.settings.padding_right | times: 0.5 | round: 0 }}px;
    }

    @media screen and (min-width: 750px) {
      .h-work-{{ section.id }} {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
        padding-left: {{ section.settings.padding_left }}px;
        padding-right: {{ section.settings.padding_right }}px;
      }
    }
</style>

<div id="{{- section.settings.redirect_section_id -}}">
  <div class="h-work h-work-{{ section.id }}" style="background-color: {{ section.settings.color }}">
    <div class="page-width">
      <h2 class="title" style="font-size:32px;">{{ section.settings.title }}</h2>
      <p class="text">{{ section.settings.subtitle }}</p>
      <div class="hw-wrap">
        {% for block in section.blocks %}
          <div class="hw-single-blck">
            <div class="hw-number bg-primary" style="background-color:#f5b83b;">{{ block.settings.number }}</div>
            <div class="hw-detail">
              <h3 class="hw-title">{{ block.settings['card-title'] }}</h3>
              <p class="hw-detail">{{ block.settings.detail }}</p>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "How It Works",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "redirect_section_id",
      "label": "Custom Section Id",
      "info": "This id will be used redirect/scroll to"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "How It Works"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "This program is designed for healthy weight loss fast, while also providing you with the tools and knowledge to keep the weight off permanently. "
    },
    {
      "type": "color",
      "id": "color",
      "label": "Backgroung Color",
      "default": "#fff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 52
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "Left Padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_right",
      "label": "Right Padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Block",
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Number",
          "default": "1"
        },
        {
          "type": "text",
          "id": "card-title",
          "label": "Title",
          "default": "Start with a cleanse"
        },
        {
          "type": "richtext",
          "id": "detail",
          "label": "Details"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "How It Works"
    }
  ]
}
{% endschema %}
