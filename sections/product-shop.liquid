 <script>
  (function() {
    const section = document.getElementById('CustomProductShop-{{ section.id }}');
    if (!section) return;

    const variants = JSON.parse(section.querySelector('[data-product-json]').textContent);
    const optionGroups = section.querySelectorAll('[data-option-index]');
    const variantIdInputs = section.querySelectorAll('[data-variant-id-input], [data-installment-variant-id]');
    const priceEl = section.querySelector('[data-price]');
    const compareEl = section.querySelector('[data-compare-price]');
    const submitButton = section.querySelector('[data-submit-button]');
    const submitText = section.querySelector('[data-submit-text]');
    const mediaSlides = Array.from(section.querySelectorAll('[data-media-slide]'));
    const thumbs = Array.from(section.querySelectorAll('[data-thumb]'));
    const prevBtn = section.querySelector('[data-media-prev]');
    const nextBtn = section.querySelector('[data-media-next]');
    const qtyInput = section.querySelector('[data-qty-input]');
    const qtyMinus = section.querySelector('[data-qty-minus]');
    const qtyPlus = section.querySelector('[data-qty-plus]');
    const shopMoneyFormat = {{ shop.money_format | json }};

    let activeMediaId = null;

    function formatMoney(cents) {
      if (window.Shopify && typeof window.Shopify.formatMoney === 'function') {
        return window.Shopify.formatMoney(cents, shopMoneyFormat);
      }

      return (cents / 100).toFixed(2);
    }

    function getSelectedOptions() {
      return Array.from(optionGroups).map((group) => {
        const checked = group.querySelector('[data-option-input]:checked');
        return checked ? checked.value : null;
      });
    }

    function findVariant() {
      const selectedOptions = getSelectedOptions();

      return variants.find((variant) => {
        return selectedOptions.every((value, index) => variant.options[index] === value);
      });
    }

    function setActiveMedia(mediaId) {
      if (!mediaId) return;

      activeMediaId = String(mediaId);

      mediaSlides.forEach((slide) => {
        slide.classList.toggle('is-active', String(slide.dataset.mediaId) === activeMediaId);
      });

      thumbs.forEach((thumb) => {
        thumb.classList.toggle('is-active', String(thumb.dataset.mediaTarget) === activeMediaId);
      });
    }

    function updateSelectedLabels() {
      optionGroups.forEach((group) => {
        const checked = group.querySelector('[data-option-input]:checked');
        const label = group.querySelector('[data-option-selected]');

        if (checked && label) {
          label.textContent = checked.value;
        }
      });
    }

    function updateVariant() {
      const variant = findVariant();
      if (!variant) return;

      variantIdInputs.forEach((input) => {
        input.value = variant.id;
        input.dispatchEvent(new Event('change', { bubbles: true }));
      });

      if (priceEl) {
        priceEl.textContent = formatMoney(variant.price);
      }

      if (compareEl) {
        if (variant.compare_at_price && variant.compare_at_price > variant.price) {
          compareEl.textContent = formatMoney(variant.compare_at_price);
          compareEl.classList.remove('is-hidden');
        } else {
          compareEl.textContent = '';
          compareEl.classList.add('is-hidden');
        }
      }

      if (submitButton && submitText) {
        if (variant.available) {
          submitButton.disabled = false;
          submitText.textContent = {{ section.settings.button_text | json }};
        } else {
          submitButton.disabled = true;
          submitText.textContent = {{ section.settings.sold_out_text | json }};
        }
      }

      if (variant.featured_media && variant.featured_media.id) {
        setActiveMedia(variant.featured_media.id);
      }

      section.dispatchEvent(new CustomEvent('variant:change', {
        bubbles: true,
        detail: {
          sectionId: {{ section.id | json }},
          variant: variant
        }
      }));
    }

    section.addEventListener('change', function(event) {
      if (event.target.matches('[data-option-input]')) {
        updateSelectedLabels();
        updateVariant();
      }
    });

    thumbs.forEach((thumb) => {
      thumb.addEventListener('click', function() {
        setActiveMedia(this.dataset.mediaTarget);
      });
    });

    function cycleMedia(direction) {
      if (!mediaSlides.length) return;

      const currentIndex = mediaSlides.findIndex((slide) => slide.classList.contains('is-active'));
      let nextIndex = currentIndex + direction;

      if (nextIndex < 0) nextIndex = mediaSlides.length - 1;
      if (nextIndex >= mediaSlides.length) nextIndex = 0;

      setActiveMedia(mediaSlides[nextIndex].dataset.mediaId);
    }

    if (prevBtn) {
      prevBtn.addEventListener('click', function() {
        cycleMedia(-1);
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', function() {
        cycleMedia(1);
      });
    }

    if (qtyMinus && qtyInput) {
      qtyMinus.addEventListener('click', function() {
        const current = parseInt(qtyInput.value || '1', 10);
        qtyInput.value = Math.max(1, current - 1);
      });
    }

    if (qtyPlus && qtyInput) {
      qtyPlus.addEventListener('click', function() {
        const current = parseInt(qtyInput.value || '1', 10);
        qtyInput.value = current + 1;
      });
    }

    const firstActiveSlide = section.querySelector('[data-media-slide].is-active');
    if (firstActiveSlide) {
      activeMediaId = firstActiveSlide.dataset.mediaId;
    }

    updateSelectedLabels();
    updateVariant();
  })();
</script>
</section>
