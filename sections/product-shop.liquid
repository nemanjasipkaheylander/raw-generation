{{ 'custom-product-shop.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign selected_variant = product.selected_or_first_available_variant
  assign product_form_id = 'custom-product-form-' | append: section.id
  assign installment_form_id = 'custom-product-installment-' | append: section.id
-%}

<section
  id="CustomProductShop-{{ section.id }}"
  class="custom-product-shop color-{{ section.settings.color_scheme }}"
  data-section-id="{{ section.id }}"
  data-product-id="{{ product.id }}"
>
  <div class="custom-product-shop__inner page-width">
    <div class="custom-product-shop__grid">
      <div class="custom-product-shop__media-col">
        <div class="custom-product-shop__media-card">
             {% if section.settings.show_bestseler %}
                   <div class="image-label">
                      <div class="label-icon">
                         <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                          <path d="M12 16.8764C15.9954 16.8764 19.2342 13.5791 19.2342 9.51169C19.2342 5.44427 15.9954 2.14697 12 2.14697C8.00464 2.14697 4.76576 5.44427 4.76576 9.51169C4.76576 13.5791 8.00464 16.8764 12 16.8764ZM12 16.8764L7.0006 21.966C6.62083 22.3526 5.97147 22.0788 5.97147 21.532V20.5588C5.97147 19.203 4.89184 18.1039 3.56006 18.1039H2.60406C2.06698 18.1039 1.798 17.4428 2.17778 17.0562L5.36862 13.8078M12 16.8764L16.9994 21.966C17.3792 22.3526 18.0285 22.0788 18.0285 21.532V20.5588C18.0285 19.203 19.1082 18.1039 20.4399 18.1039H21.3959C21.933 18.1039 22.202 17.4428 21.8222 17.0562L18.6314 13.8078" stroke="white" stroke-width="2" stroke-linecap="round"/>
                          </svg>

                      </div>
                      <div class="text-label">Best Seller</div>
                   </div>
                {% endif %}
                {% if section.settings.show_free_app %}
                <div class="image-label-second">
                  <div class="label-icon">
                      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M17 2H7C5.89543 2 5 2.89543 5 4V20C5 21.1046 5.89543 22 7 22H17C18.1046 22 19 21.1046 19 20V4C19 2.89543 18.1046 2 17 2Z" stroke="#EB51FF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                      <path d="M12 18H12.01" stroke="#EB51FF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                  </div>
                  <div class="text-label">free app included</div>
                </div>
            {% endif %}
          {%- if product.media.size > 0 -%}
            <div class="custom-product-shop__media-stage">
              <button
                type="button"
                class="custom-product-shop__media-nav custom-product-shop__media-nav--prev"
                aria-label="Previous media"
                data-media-prev
              >
                −
              </button>

              <div class="custom-product-shop__media-main" data-media-main>
             
                {%- for media in product.media -%}
                  <div
                    class="custom-product-shop__media-slide{% if media.id == selected_variant.featured_media.id or forloop.first and selected_variant.featured_media == blank %} is-active{% endif %}"
                    data-media-slide
                    data-media-id="{{ media.id }}"
                  >
                    {%- case media.media_type -%}
                      {%- when 'image' -%}
                        <img
                          src="{{ media | image_url: width: 1200 }}"
                          alt="{{ media.alt | escape }}"
                          loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                          width="{{ media.preview_image.width }}"
                          height="{{ media.preview_image.height }}"
                        >
                      {%- when 'external_video' -%}
                        {{ media | external_video_tag: class: 'custom-product-shop__video', loading: 'lazy' }}
                      {%- when 'video' -%}
                        {{ media | video_tag: class: 'custom-product-shop__video', controls: true, preload: 'metadata' }}
                      {%- else -%}
                        {{ media | media_tag }}
                    {%- endcase -%}
                  </div>
                {%- endfor -%}
              </div>

              <button
                type="button"
                class="custom-product-shop__media-nav custom-product-shop__media-nav--next"
                aria-label="Next media"
                data-media-next
              >
                +
              </button>
            </div>

            <div class="custom-product-shop__thumbs" data-media-thumbs>
              {%- for media in product.media -%}
                <button
                  type="button"
                  class="custom-product-shop__thumb{% if media.id == selected_variant.featured_media.id or forloop.first and selected_variant.featured_media == blank %} is-active{% endif %}"
                  data-thumb
                  data-media-target="{{ media.id }}"
                  aria-label="Show media {{ forloop.index }}"
                >
                  {%- if media.preview_image != blank -%}
                    <img
                      src="{{ media.preview_image | image_url: width: 180 }}"
                      alt="{{ media.alt | escape }}"
                      loading="lazy"
                      width="90"
                      height="90"
                    >
                  {%- endif -%}
                </button>
              {%- endfor -%}
            </div>
          {%- else -%}
            <div class="custom-product-shop__media-placeholder">
              {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
          {%- endif -%}
        </div>

        {%- for block in section.blocks -%}
          {%- if block.type == 'testimonial' -%}
            <div class="custom-product-shop__testimonial" {{ block.shopify_attributes }}>
              <div class="custom-product-shop__testimonial-avatar">
                {%- if block.settings.image != blank -%}
                  <img
                    src="{{ block.settings.image | image_url: width: 120 }}"
                    alt="{{ block.settings.name | escape }}"
                    loading="lazy"
                    width="56"
                    height="56"
                  >
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </div>
              <div class="custom-product-shop__testimonial-content">
                {%- if block.settings.text != blank -%}
                  <div class="custom-product-shop__testimonial-text">{{ block.settings.text }}</div>
                {%- endif -%}
                <div class="custom-product-shop__testimonial-meta">
                  {%- if block.settings.name != blank -%}
                    <strong>{{ block.settings.name }}</strong>
                  {%- endif -%}
                  {%- if block.settings.meta != blank -%}
                    <span>{{ block.settings.meta }}</span>
                  {%- endif -%}
                </div>
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>

      <div class="custom-product-shop__info-col">
  {%- if section.settings.eyebrow != blank -%}
    <div class="custom-product-shop__eyebrow">{{ section.settings.eyebrow }}</div>
  {%- endif -%}

  {%- if section.settings.show_vendor and product.vendor != blank -%}
    <div class="custom-product-shop__vendor">{{ product.vendor }}</div>
  {%- endif -%}

  {% if section.settings.show_review %}
    <div class="prod-custom-review">
      <div class="prod-custom-review__stars">
        <svg width="98" height="18" viewBox="0 0 98 18" fill="none" xmlns="http://www.w3.org/2000/svg">
