  padding: 12px 10px;
  border: 1px solid #d8c7dc;
  border-radius: 12px;
  background: #faf7fb;
  transition: 0.2s ease;
}

.custom-product-shop__variant-card input:checked + .custom-product-shop__variant-card-inner {
  border-color: #b600ff;
  background: #f7e9ff;
  box-shadow: 0 0 0 1px #b600ff inset;
}

.custom-product-shop__variant-card.is-disabled,
.custom-product-shop__variant-card input:disabled + .custom-product-shop__variant-card-inner {
  opacity: 0.45;
  cursor: not-allowed;
}

.custom-product-shop__variant-badge {
  align-self: flex-start;
  margin-bottom: 6px;
  padding: 4px 7px;
  border-radius: 999px;
  background: #ffd6f6;
  color: #8a00b8;
  font-size: 10px;
  font-weight: 700;
  line-height: 1;
}

.custom-product-shop__variant-title {
  font-size: 13px;
  font-weight: 700;
  color: #231b28;
  line-height: 1.2;
}

.custom-product-shop__variant-value {
  margin-top: 4px;
  font-size: 14px;
  color: #3f3346;
  font-weight: 600;
}

.custom-product-shop__variant-subtext {
  margin-top: 6px;
  font-size: 11px;
  line-height: 1.35;
  color: #7e7186;
}

.custom-product-shop__app-block {
  padding: 14px;
  margin-bottom: 16px;
}

.custom-product-shop__purchase-box {
  padding: 14px;
  margin-bottom: 16px;
}

.custom-product-shop__form {
  display: grid;
  gap: 12px;
}

.custom-product-shop__qty-row {
  display: inline-grid;
  grid-template-columns: 44px 72px 44px;
  border: 1px solid #d8c7dc;
  border-radius: 12px;
  overflow: hidden;
  width: fit-content;
  background: #fff;
}

.custom-product-shop__qty-btn {
  border: 0;
  background: #fff;
  font-size: 24px;
  cursor: pointer;
}

.custom-product-shop__qty-input {
  border: 0;
  text-align: center;
  font-size: 16px;
  width: 72px;
  outline: none;
}

.custom-product-shop__submit {
  width: 100%;
  min-height: 54px;
  border: 0;
  border-radius: 12px;
  background: linear-gradient(180deg, #c61cff 0%, #9800ff 100%);
  color: #fff;
  font-size: 16px;
  font-weight: 800;
  cursor: pointer;
  box-shadow: 0 8px 20px rgba(164, 0, 255, 0.18);
}

.custom-product-shop__submit[disabled] {
  opacity: 0.5;
  cursor: not-allowed;
}

.custom-product-shop__dynamic-checkout > * {
  width: 100%;
}

.custom-product-shop__trust-row {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10px;
  padding: 12px;
  margin-bottom: 16px;
}

.custom-product-shop__trust-item {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  min-height: 42px;
  font-size: 12px;
  text-align: center;
  color: #463b4d;
}

.custom-product-shop__trust-item img {
  width: 18px;
  height: 18px;
  object-fit: contain;
}

.custom-product-shop__trust-dot {
  width: 8px;
  height: 8px;
  border-radius: 999px;
  background: #b600ff;
}

.custom-product-shop__accordions {
  display: grid;
  gap: 10px;
}

.custom-product-shop__accordion {
  overflow: hidden;
}

.custom-product-shop__accordion-summary {
  list-style: none;
  cursor: pointer;
  padding: 16px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  font-size: 14px;
  font-weight: 700;
  color: #231b28;
}

.custom-product-shop__accordion-summary::-webkit-details-marker {
  display: none;
}

.custom-product-shop__accordion[open] .custom-product-shop__accordion-icon {
  transform: rotate(45deg);
}

.custom-product-shop__accordion-icon {
  transition: transform 0.2s ease;
  font-size: 22px;
  line-height: 1;
}

.custom-product-shop__accordion-content {
  padding: 0 16px 16px;
  color: #4f4456;
  font-size: 14px;
}

.custom-product-shop__installments {
  margin-top: 14px;
  font-size: 13px;
  color: #736778;
}
.custom-product-shop__upsell {
  margin-bottom: 16px;
}

.custom-product-shop__upsell-card {
  display: grid;
  grid-template-columns: 180px minmax(0, 1fr);
  gap: 18px;
  padding: 16px;
  background: #fff;
  border: 1px solid #b600ff;
  border-radius: 18px;
  box-shadow: 0 6px 16px rgba(0, 0, 0, 0.04);
}

.custom-product-shop__upsell-media {
  background: #f5f5f7;
  border-radius: 14px;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 180px;
}

.custom-product-shop__upsell-media img {
  width: 100%;
  height: auto;
  display: block;
  object-fit: contain;
}

.custom-product-shop__upsell-content {
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.custom-product-shop__upsell-label {
  font-size: 11px;
  line-height: 1.2;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  color: #6f5f79;
  margin-bottom: 8px;
}

.custom-product-shop__upsell-title {
  font-size: 18px;
  line-height: 1.15;
  font-weight: 800;
  color: #17121a;
  margin-bottom: 8px;
}

.custom-product-shop__upsell-description {
  font-size: 14px;
  line-height: 1.4;
  color: #312736;
  margin-bottom: 12px;
}

.custom-product-shop__upsell-price-wrap {
  display: flex;
  align-items: baseline;
  gap: 10px;
  margin-bottom: 16px;
}

.custom-product-shop__upsell-price {
  color: #ff2f3d;
  font-size: 18px;
  font-weight: 800;
  line-height: 1;
}

.custom-product-shop__upsell-compare {
  color: #8b7f92;
  font-size: 15px;
  text-decoration: line-through;
}

.custom-product-shop__upsell-form {
  width: 100%;
}

.custom-product-shop__upsell-button {
  width: 100%;
  min-height: 56px;
  border: 0;
  border-radius: 14px;
  background: linear-gradient(180deg, #c61cff 0%, #9800ff 100%);
  color: #fff;
  font-size: 16px;
  font-weight: 800;
  cursor: pointer;
  box-shadow: 0 8px 20px rgba(164, 0, 255, 0.18);
}

.custom-product-shop__upsell-button[disabled] {
  opacity: 0.5;
  cursor: not-allowed;
}

@media screen and (max-width: 749px) {
  .custom-product-shop__upsell-card {
    grid-template-columns: 1fr;
    gap: 14px;
  }

  .custom-product-shop__upsell-media {
    min-height: 160px;
  }

  .custom-product-shop__upsell-title {
    font-size: 16px;
  }

  .custom-product-shop__upsell-description {
    font-size: 13px;
  }
}

@media screen and (max-width: 989px) {
  .custom-product-shop {
    padding: 14px 0 24px;
  }

  .custom-product-shop__grid {
    grid-template-columns: 1fr;
    gap: 18px;
  }

  .custom-product-shop__title {
    font-size: 28px;
  }

  .custom-product-shop__price {
    font-size: 26px;
  }

  .custom-product-shop__option-values {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .custom-product-shop__trust-row {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media screen and (max-width: 640px) {
  .custom-product-shop__media-card,
  .custom-product-shop__purchase-box,
  .custom-product-shop__app-block,
  .custom-product-shop__accordion,
  .custom-product-shop__testimonial,
  .custom-product-shop__trust-row,
  .custom-product-shop__variants {
    border-radius: 14px;
  }

  .custom-product-shop__media-stage {
    grid-template-columns: 32px minmax(0, 1fr) 32px;
    gap: 8px;
  }

  .custom-product-shop__media-nav {
    width: 32px;
    height: 32px;
    font-size: 20px;
  }

  .custom-product-shop__option-values {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
  }

  .custom-product-shop__variant-card-inner {
    min-height: 78px;
    padding: 10px 8px;
  }

  .custom-product-shop__variant-title {
    font-size: 12px;
  }

  .custom-product-shop__variant-value {
    font-size: 13px;
  }

  .custom-product-shop__variant-subtext {
    font-size: 10px;
  }

  .custom-product-shop__trust-row {
    grid-template-columns: 1fr 1fr;
  }

  .custom-product-shop__trust-item {
    font-size: 11px;
  }
}
