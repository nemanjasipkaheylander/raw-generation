  <h1 class="custom-product-shop__title">{{ product.title }}</h1>

  {%- for block in section.blocks -%}
    {%- case block.type -%}

      {%- when 'price' -%}
        <div class="custom-product-shop__price-wrap" id="custom-price-{{ section.id }}" {{ block.shopify_attributes }}>
          <div class="custom-product-shop__price-row">
            <span class="custom-product-shop__price" data-price>
              {{ selected_variant.price | money }}
            </span>
            <span
              class="custom-product-shop__compare{% if selected_variant.compare_at_price <= selected_variant.price or selected_variant.compare_at_price == blank %} is-hidden{% endif %}"
              data-compare-price
            >
              {%- if selected_variant.compare_at_price > selected_variant.price -%}
                {{ selected_variant.compare_at_price | money }}
              {%- endif -%}
            </span>
          </div>
        </div>

      {%- when 'description' -%}
        <div class="custom-product-shop__subprice" {{ block.shopify_attributes }}>
          {%- if block.settings.description != blank -%}
            {{ block.settings.description }}
          {%- else -%}
            {{ product.description | strip_html }}
          {%- endif -%}
        </div>

      {%- when 'benefits' -%}
        <ul class="custom-product-shop__benefits" {{ block.shopify_attributes }}>
          {%- if block.settings.benefit_1 != blank -%}
            <li class="custom-product-shop__benefit">
              <span class="custom-product-shop__benefit-icon">
                <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <g clip-path="url(#clip-benefit-1)">
                    <path d="M18 8.99951C18 4.02895 13.9705 -0.000488281 9 -0.000488281C4.02943 -0.000488281 0 4.02895 0 8.99951C0 13.97 4.02943 17.9995 9 17.9995C13.9705 17.9995 18 13.97 18 8.99951Z" fill="#A200F9"/>
                    <path d="M5.19189 9.86869L7.35535 12.0321L12.115 6.83984" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </g>
                  <defs>
                    <clipPath id="clip-benefit-1">
                      <rect width="18" height="18" fill="white"/>
                    </clipPath>
                  </defs>
                </svg>
              </span>
              <span>{{ block.settings.benefit_1 }}</span>
            </li>
          {%- endif -%}

          {%- if block.settings.benefit_2 != blank -%}
            <li class="custom-product-shop__benefit">
              <span class="custom-product-shop__benefit-icon">
                <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <g clip-path="url(#clip-benefit-2)">
                    <path d="M18 8.99951C18 4.02895 13.9705 -0.000488281 9 -0.000488281C4.02943 -0.000488281 0 4.02895 0 8.99951C0 13.97 4.02943 17.9995 9 17.9995C13.9705 17.9995 18 13.97 18 8.99951Z" fill="#A200F9"/>
                    <path d="M5.19189 9.86869L7.35535 12.0321L12.115 6.83984" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </g>
                  <defs>
                    <clipPath id="clip-benefit-2">
                      <rect width="18" height="18" fill="white"/>
                    </clipPath>
                  </defs>
                </svg>
              </span>
              <span>{{ block.settings.benefit_2 }}</span>
            </li>
          {%- endif -%}

          {%- if block.settings.benefit_3 != blank -%}
            <li class="custom-product-shop__benefit">
              <span class="custom-product-shop__benefit-icon">
                <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <g clip-path="url(#clip-benefit-3)">
                    <path d="M18 8.99951C18 4.02895 13.9705 -0.000488281 9 -0.000488281C4.02943 -0.000488281 0 4.02895 0 8.99951C0 13.97 4.02943 17.9995 9 17.9995C13.9705 17.9995 18 13.97 18 8.99951Z" fill="#A200F9"/>
                    <path d="M5.19189 9.86869L7.35535 12.0321L12.115 6.83984" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </g>
                  <defs>
                    <clipPath id="clip-benefit-3">
                      <rect width="18" height="18" fill="white"/>
                    </clipPath>
                  </defs>
                </svg>
              </span>
              <span>{{ block.settings.benefit_3 }}</span>
            </li>
          {%- endif -%}

          {%- if block.settings.benefit_4 != blank -%}
            <li class="custom-product-shop__benefit">
              <span class="custom-product-shop__benefit-icon">
                <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <g clip-path="url(#clip-benefit-4)">
                    <path d="M18 8.99951C18 4.02895 13.9705 -0.000488281 9 -0.000488281C4.02943 -0.000488281 0 4.02895 0 8.99951C0 13.97 4.02943 17.9995 9 17.9995C13.9705 17.9995 18 13.97 18 8.99951Z" fill="#A200F9"/>
                    <path d="M5.19189 9.86869L7.35535 12.0321L12.115 6.83984" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </g>
                  <defs>
                    <clipPath id="clip-benefit-4">
                      <rect width="18" height="18" fill="white"/>
                    </clipPath>
                  </defs>
                </svg>
              </span>
              <span>{{ block.settings.benefit_4 }}</span>
            </li>
          {%- endif -%}

          {%- if block.settings.benefit_5 != blank -%}
            <li class="custom-product-shop__benefit">
              <span class="custom-product-shop__benefit-icon">
                <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <g clip-path="url(#clip-benefit-4)">
                    <path d="M18 8.99951C18 4.02895 13.9705 -0.000488281 9 -0.000488281C4.02943 -0.000488281 0 4.02895 0 8.99951C0 13.97 4.02943 17.9995 9 17.9995C13.9705 17.9995 18 13.97 18 8.99951Z" fill="#A200F9"/>
                    <path d="M5.19189 9.86869L7.35535 12.0321L12.115 6.83984" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </g>
                  <defs>
