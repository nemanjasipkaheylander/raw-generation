          </div>
          <div class="hp-hl-hero__ratings-text">
            {{ section.settings.hero_review_text_one }} | <span class="review-text-second">{{ section.settings.hero_review_text_two }}</span>
          </div>
        </div>
      {% endif %}

      {% if section.settings.hero_tagline %}
        <div class="hl-hp-hero__tagline">{{ section.settings.hero_tagline }}</div>
      {% endif %}

      <h1 class="hl-hp-hero_title">{{ section.settings.hero_title }}</h1>

      <p class="hl-hp-hero__subtitle">{{ section.settings.hero_subtitle }}</p>

      <div class="hl-hp-hero__button-wrapper">
        {% if section.settings.hero_button_one_url != blank %}
          <a href="{{ section.settings.hero_button_one_url }}" title="{{ section.settings.hero_button_one_text }}">
            <div class="hl-hp-hero__button-primary">{{ section.settings.hero_button_one_text }}</div>
          </a>
        {% endif %}

        {% if section.settings.hero_button_two_url != blank %}
          <a href="{{ section.settings.hero_button_two_url }}" title="{{ section.settings.hero_button_two_text }}">
            <div class="hl-hp-hero__button-secondary">{{ section.settings.hero_button_two_text }}</div>
          </a>
        {% endif %}

        {% if section.settings.hero_button_three_url != blank %}
          <a href="{{ section.settings.hero_button_three_url }}" title="{{ section.settings.hero_button_three_text }}">
            <div class="hl-hp-hero__button-secondary">{{ section.settings.hero_button_three_text }}</div>
          </a>
        {% endif %}
      </div>

    </div>

    <div class="hl-hp-hero__right-side">
      {% if section.settings.hero_image_mobile != blank %}
        {{
          section.settings.hero_image_mobile
          | image_url: width: 800
          | image_tag: class: 'hl-hp-hero__img hl-hp-hero__img--mobile', loading: 'lazy'
        }}
      {% elsif section.settings.hero_image != blank %}
        {{
          section.settings.hero_image
          | image_url: width: 800
          | image_tag: class: 'hl-hp-hero__img hl-hp-hero__img--mobile', loading: 'lazy'
        }}
      {% endif %}

      {% if section.settings.hero_image != blank %}
        {{
          section.settings.hero_image
          | image_url: width: 2000
          | image_tag: class: 'hl-hp-hero__img hl-hp-hero__img--desktop', loading: 'lazy'
        }}
      {% endif %}
    </div>

  </div>
</section>

{% comment %} <script src='{{ '' | asset_url }}' defer='defer'></script> {% endcomment %}

{% schema %}
{
  "name": "HP Hero",
  "settings": [
    {
      "type": "header",
      "content": "Section Settings"
    },
    {
      "type": "text",
      "id": "section_target",
      "label": "Section Target"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section background color"
    },
    {
      "type": "color",
      "id": "bg_gradient_1",
      "label": "Section gradient color first"
    },
    {
      "type": "color",
      "id": "bg_gradient_2",
      "label": "Section gradient color second"
    },
    {
      "type": "text",
      "id": "padding_top",
      "label": "Section padding top - small screens"
    },
    {
      "type": "text",
      "id": "padding_bottom",
      "label": "Section padding bottom - small screens"
    },
    {
      "type": "text",
      "id": "padding_top_desk",
      "label": "Section padding top - large screens"
    },
    {
      "type": "text",
      "id": "padding_bottom_desk",
      "label": "Section padding bottom - large screens"
    },
    {
      "type": "header",
      "content": "Section Content"
    },
    {
      "type": "text",
      "id": "hero_review_text_one",
      "label": "Enter review text",
      "default": "4.45/5"
    },
    {
      "type": "text",
      "id": "hero_review_text_two",
      "label": "Enter review text",
      "default": "10,000+ happy customers"
    },
    {
      "type": "text",
      "id": "hero_tagline",
      "label": "Enter tagline",
      "default": "Designed By a Holistic Nutritionist"
    },
    {
      "type": "text",
      "id": "hero_title",
      "label": "Enter title",
      "default": "Juice Cleanses, Cold Pressed Juices & Wellness Programs for You"
    },
    {
      "type": "text",
      "id": "hero_subtitle",
      "label": "Enter subtitle",
      "default": "Nutritious raw juices and juice cleanses to help you reset and feel lighter WITHOUT calorie counting."
    },
    {
      "type": "url",
      "id": "hero_button_one_url",
      "label": "Paste url"
    },
    {
      "type": "text",
      "id": "hero_button_one_text",
      "label": "Enter button text"
    },
    {
      "type": "url",
      "id": "hero_button_two_url",
      "label": "Paste url"
    },
    {
      "type": "text",
      "id": "hero_button_two_text",
      "label": "Enter button text"
    },
    {
      "type": "url",
      "id": "hero_button_three_url",
      "label": "Paste url"
    },
    {
      "type": "text",
      "id": "hero_button_three_text",
      "label": "Enter button text"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Upload image - desktop"
    },
    {
      "type": "image_picker",
      "id": "hero_image_mobile",
      "label": "Upload image - mobile"
    }
  ],
  "presets": [
    {
      "name": "HP Hero"
    }
  ]
}
{% endschema %}