{{ '' | asset_url | stylesheet_tag }}

{% liquid
  assign section_target = section.settings.section_target
  assign bg_color = section.settings.bg_color
  assign bg_gradient_1 = section.settings.bg_gradient_1
  assign bg_gradient_2 = section.settings.bg_gradient_2
  assign padding_top = section.settings.padding_top
  assign padding_bottom = section.settings.padding_bottom
  assign padding_top_desk = section.settings.padding_top_desk
  assign padding_bottom_desk = section.settings.padding_bottom_desk
%}
{% style %}
  .{{ section.id }} {
    position: relative;
    background-color: {{ bg_color }};
    background-image: linear-gradient(to bottom, {{ bg_gradient_1 }} 0%, {{ bg_gradient_2 }} 100%);
    padding-top: {{ padding_top }}px;
    padding-bottom: {{ padding_bottom }}px;
  }

  @media (min-width: 768px) {
    .{{ section.id }} {
      padding-top: {{ padding_top_desk }}px;
      padding-bottom: {{ padding_bottom_desk }}px;
    }
  }

  /* hero wrapper */
  .hl-hp-hero {
    position: relative;
    font-family: Jost;
  }

  /* pozadinska slika - pokriva celu sekciju */
  .hl-hp-hero__right-side {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    pointer-events: none;
    z-index: 0;
  }

  .hl-hp-hero__right-side img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  /* spacer - u normalnom flow-u, daje visinu sekciji */
  .hl-hp-hero__spacer-wrapper {
    width: 100%;
    position: relative;
    z-index: 0;
  }

  .hl-hp-hero__spacer {
    display: block;
    width: 100%;
    visibility: hidden;
    pointer-events: none;
  }

  /* .l lebdi preko spacera */
  .hl-hp-hero .l {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 2;
    display: flex;
    align-items: flex-start;
  }

  /* left side sadrzaj */
  .hl-hp-hero__left-side {
    position: relative;
    z-index: 2;
    text-align: center;
    max-width: 650px;
    padding: 0 20px;
  }

  /* ratings */
  .hp-hl-hero__ratings-wrapper {
    display: flex;
    gap: 5px;
    align-items: center;
    padding: 5px 10px;
    background: #fff;
    border-radius: 50px;
    margin: 0 auto;
    margin-bottom: 16px;
    max-width: fit-content;
    font-size: 13px;
  }

  /* tagline */
  .hl-hp-hero__tagline {
    color: #A548D8;
    font-size: 15px;
    text-transform: uppercase;
    font-weight: 600;
  }

  /* title */
  .hl-hp-hero_title {
    font-size: 30px;
    line-height: 130%;
    margin-bottom: 16px;
    font-weight: 400;
  }

  /* subtitle */
  .hl-hp-hero__subtitle {
    font-size: 14px;
    font-weight: 300;
    margin-bottom: 24px;
  }

  /* buttons */
  .hl-hp-hero__button-wrapper {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    max-width: 480px;
  }

  .hl-hp-hero__button-wrapper a {
    width: 100%;
  }

  .hl-hp-hero__button-primary {
    width: 100%;
    padding: 13px;
    color: #fff;
    background: #A200F9;
    border-radius: 5px;
    text-transform: uppercase;
  }

  .hl-hp-hero__button-secondary {
    width: 100%;
    padding: 13px;
    color: #A200F9;
    background: #fff;
    border: 1px solid #A200F9;
    border-radius: 5px;
    text-transform: uppercase;
  }

  /* images */
  .hl-hp-hero__img--mobile {
    display: block;
  }

  .hl-hp-hero__img--desktop {
    display: none;
  }

  /* desktop */
  @media (min-width: 768px) {
    .hl-hp-hero__left-side {
      max-width: 610px;
      text-align: left;
    }

    .hp-hl-hero__ratings-wrapper {
      font-size: 16px;
      margin: 0;
      margin-bottom: 16px;
    }

    .hl-hp-hero__tagline {
      font-size: 16px;
    }

    .hl-hp-hero_title {
      font-size: 40px;
    }

    .hl-hp-hero__subtitle {
      font-size: 18px;
    }

    .hl-hp-hero__button-wrapper a {
      width: auto;
    }

    .hl-hp-hero__button-primary {
      width: auto;
      padding: 13px 24px;
      max-width: fit-content;
    }

    .hl-hp-hero__button-secondary {
      width: auto;
      padding: 13px 24px;
      max-width: fit-content;
    }

    .hl-hp-hero__img--mobile {
      display: none;
    }

    .hl-hp-hero__img--desktop {
      display: block;
    }
  }
{% endstyle %}
<section class="{{ section.id }} hl-hp-hero" id="{{ section_target }}">

  {% comment %} pozadinska slika - van .l containera {% endcomment %}
  <div class="hl-hp-hero__right-side">
    {% if section.settings.hero_image_mobile != blank %}
      {{
        section.settings.hero_image_mobile
        | image_url: width: 800
        | image_tag: class: 'hl-hp-hero__img hl-hp-hero__img--mobile', loading: 'lazy'
      }}
    {% elsif section.settings.hero_image != blank %}
      {{
        section.settings.hero_image
        | image_url: width: 800
        | image_tag: class: 'hl-hp-hero__img hl-hp-hero__img--mobile', loading: 'lazy'
      }}
    {% endif %}

    {% if section.settings.hero_image != blank %}
      {{
        section.settings.hero_image
        | image_url: width: 2000
        | image_tag: class: 'hl-hp-hero__img hl-hp-hero__img--desktop', loading: 'lazy'
      }}
    {% endif %}
  </div>

  {% comment %} spacer - van .l containera, daje visinu sekciji {% endcomment %}
  <div class="hl-hp-hero__spacer-wrapper">
    {% if section.settings.hero_image_mobile != blank %}
      {{
        section.settings.hero_image_mobile
        | image_url: width: 800
        | image_tag: class: 'hl-hp-hero__spacer hl-hp-hero__img--mobile', loading: 'lazy'
      }}
    {% elsif section.settings.hero_image != blank %}
      {{
        section.settings.hero_image
        | image_url: width: 800
        | image_tag: class: 'hl-hp-hero__spacer hl-hp-hero__img--mobile', loading: 'lazy'
      }}
    {% endif %}

    {% if section.settings.hero_image != blank %}
      {{
        section.settings.hero_image
        | image_url: width: 2000
        | image_tag: class: 'hl-hp-hero__spacer hl-hp-hero__img--desktop', loading: 'lazy'
      }}
    {% endif %}
  </div>

  <div class="l">
    <div class="hl-hp-hero__left-side">
      {%- comment -%} sadrzaj ostaje isti {%- endcomment -%}
    </div>
  </div>

</section>
{% comment %} <script src='{{ '' | asset_url }}' defer='defer'></script> {% endcomment %}

