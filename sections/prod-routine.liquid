{{ '../assets/prod-routine.css' | asset_url | stylesheet_tag }}
{{ 'prod-routine.js' | asset_url | script_tag }}

{% liquid
  assign section_target = section.settings.section_target
  assign bg_gradient_1 = section.settings.bg_gradient_1
  assign bg_gradient_2 = section.settings.bg_gradient_2
  assign padding_top = section.settings.padding_top
  assign padding_bottom = section.settings.padding_bottom
  assign padding_top_desk = section.settings.padding_top_desk
  assign padding_bottom_desk = section.settings.padding_bottom_desk
%}

{% style %}
  .{{ section.id }} {
    position: relative;
    background-image: linear-gradient(to bottom, {{ bg_gradient_1 }} 0%, {{ bg_gradient_2 }} 100%);
    padding-top: {{ padding_top }}px;
    padding-bottom: {{ padding_bottom }}px;
  }
  @media (min-width: 768px) {
    .{{ section.id }} {
      padding-top: {{ padding_top_desk }}px;
      padding-bottom: {{ padding_bottom_desk }}px;
    }
  }

{% endstyle %}

<section class="{{ section.id }} routine" id="{{ section_target }}">
  <div class="l">
    <div class="routine__header">
      <h2 class="routine__title">
        {{ section.settings.section_title_one }}
        <span class="routine__purple">{{ section.settings.section_title_two }}</span>
      </h2>
      <div class='routine_left'>
      <!-- Desktop: arrows + CTA in header -->
      <div class="swiper-navigation-wrapper swiper-nav-desk">
        <div class="collection-button collection-button-prev">
          <svg width="18" height="15" viewBox="0 0 18 15" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M18.0006 7.50042C18.0006 7.69933 17.9216 7.8901 17.7809 8.03075C17.6403 8.1714 17.4495 8.25042 17.2506 8.25042H2.5609L8.03122 13.7198C8.1009 13.7895 8.15617 13.8722 8.19389 13.9632C8.2316 14.0543 8.25101 14.1519 8.25101 14.2504C8.25101 14.349 8.2316 14.4465 8.19389 14.5376C8.15617 14.6286 8.1009 14.7114 8.03122 14.781C7.96153 14.8507 7.87881 14.906 7.78776 14.9437C7.69672 14.9814 7.59914 15.0008 7.50059 15.0008C7.40204 15.0008 7.30446 14.9814 7.21342 14.9437C7.12237 14.906 7.03965 14.8507 6.96996 14.781L0.219965 8.03104C0.150233 7.96139 0.0949134 7.87867 0.0571702 7.78762C0.019427 7.69657 0 7.59898 0 7.50042C0 7.40186 0.019427 7.30426 0.0571702 7.21321C0.0949134 7.12216 0.150233 7.03945 0.219965 6.96979L6.96996 0.219792C7.1107 0.0790615 7.30157 -1.48284e-09 7.50059 0C7.69961 1.48284e-09 7.89048 0.0790615 8.03122 0.219792C8.17195 0.360523 8.25101 0.551394 8.25101 0.750417C8.25101 0.94944 8.17195 1.14031 8.03122 1.28104L2.5609 6.75042H17.2506C17.4495 6.75042 17.6403 6.82943 17.7809 6.97009C17.9216 7.11074 18.0006 7.3015 18.0006 7.50042Z" fill="#A200F9"/>
          </svg>
        </div>
        <div class="collection-button collection-button-next">
          <svg width="18" height="15" viewBox="0 0 18 15" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M2.09808e-05 7.50042C2.09808e-05 7.69933 0.0790386 7.8901 0.21969 8.03075C0.360342 8.1714 0.551109 8.25042 0.750021 8.25042H15.4397L9.96939 13.7198C9.89971 13.7895 9.84444 13.8722 9.80672 13.9632C9.76901 14.0543 9.7496 14.1519 9.7496 14.2504C9.7496 14.349 9.76901 14.4465 9.80672 14.5376C9.84444 14.6286 9.89971 14.7114 9.96939 14.781C10.0391 14.8507 10.1218 14.906 10.2128 14.9437C10.3039 14.9814 10.4015 15.0008 10.5 15.0008C10.5986 15.0008 10.6961 14.9814 10.7872 14.9437C10.8782 14.906 10.961 14.8507 11.0306 14.781L17.7806 8.03104C17.8504 7.96139 17.9057 7.87867 17.9434 7.78762C17.9812 7.69657 18.0006 7.59898 18.0006 7.50042C18.0006 7.40186 17.9812 7.30426 17.9434 7.21321C17.9057 7.12216 17.8504 7.03945 17.7806 6.96979L11.0306 0.219792C10.8899 0.0790615 10.699 -1.48284e-09 10.5 0C10.301 1.48284e-09 10.1101 0.0790615 9.96939 0.219792C9.82866 0.360523 9.7496 0.551394 9.7496 0.750417C9.7496 0.94944 9.82866 1.14031 9.96939 1.28104L15.4397 6.75042H0.750021C0.551109 6.75042 0.360342 6.82943 0.21969 6.97009C0.0790386 7.11074 2.09808e-05 7.3015 2.09808e-05 7.50042Z" fill="#A200F9"/>
          </svg>
        </div>
      </div>

      {% if section.settings.section_button_url != blank %}
        <a href="{{ section.settings.section_button_url }}" title="{{ section.settings.section_button_text }}" class="routine__cta-btn">
          {{ section.settings.section_button_text }}
        </a>
      {% endif %}
    </div>
        
      </div>



    <!-- Swiper -->
    <div class="routine__content-wrapper swiper routine-swiper">
      <div class="swiper-wrapper">
        {% for block in section.blocks %}
          <div class="routine__card swiper-slide" {{ block.shopify_attributes }}>
            <figure class="routine__image">
              {{ block.settings.routine_img | image_url: width: 320 | image_tag: class: 'routine_img', loading: 'lazy' }}
            </figure>
            <div class="routine__header-card">
              <div class="routine__header-wrapp">
                <div class="routine__time">

                  {{ block.settings.routine_time }}

                                    <div class="routine__time-icon">
                    <svg width="15" height="15" viewBox="0 0 15 15" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <g clip-path="url(#clip0_1_622)">
                        <path d="M7.49998 13.9287C11.0504 13.9287 13.9286 11.0506 13.9286 7.50011C13.9286 3.9497 11.0504 1.07153 7.49998 1.07153C3.94958 1.07153 1.07141 3.9497 1.07141 7.50011C1.07141 11.0506 3.94958 13.9287 7.49998 13.9287Z" stroke="#EB51FF" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M7.50044 5.02759V7.50012L5.02747 9.97264" stroke="#EB51FF" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                      </g>
                      <defs>
                        <clipPath id="clip0_1_622">
                          <rect width="15" height="15" fill="white"/>
                        </clipPath>
                      </defs>
                    </svg>
                  </div>
                </div>
                <div class="outine_title-slider">{{ block.settings.routine_title }}</div>
              </div>
              <div class="routine__content">
                {{ block.settings.routine_text }}
              </div>
            </div>
          </div>
        {% endfor %}
      </div>


      <!-- Mobile: arrows below slider -->
      <div class="swiper-navigation-wrapper swiper-nav-mob">
        <div class="collection-button collection-button-prev">
          <svg width="18" height="15" viewBox="0 0 18 15" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M18.0006 7.50042C18.0006 7.69933 17.9216 7.8901 17.7809 8.03075C17.6403 8.1714 17.4495 8.25042 17.2506 8.25042H2.5609L8.03122 13.7198C8.1009 13.7895 8.15617 13.8722 8.19389 13.9632C8.2316 14.0543 8.25101 14.1519 8.25101 14.2504C8.25101 14.349 8.2316 14.4465 8.19389 14.5376C8.15617 14.6286 8.1009 14.7114 8.03122 14.781C7.96153 14.8507 7.87881 14.906 7.78776 14.9437C7.69672 14.9814 7.59914 15.0008 7.50059 15.0008C7.40204 15.0008 7.30446 14.9814 7.21342 14.9437C7.12237 14.906 7.03965 14.8507 6.96996 14.781L0.219965 8.03104C0.150233 7.96139 0.0949134 7.87867 0.0571702 7.78762C0.019427 7.69657 0 7.59898 0 7.50042C0 7.40186 0.019427 7.30426 0.0571702 7.21321C0.0949134 7.12216 0.150233 7.03945 0.219965 6.96979L6.96996 0.219792C7.1107 0.0790615 7.30157 -1.48284e-09 7.50059 0C7.69961 1.48284e-09 7.89048 0.0790615 8.03122 0.219792C8.17195 0.360523 8.25101 0.551394 8.25101 0.750417C8.25101 0.94944 8.17195 1.14031 8.03122 1.28104L2.5609 6.75042H17.2506C17.4495 6.75042 17.6403 6.82943 17.7809 6.97009C17.9216 7.11074 18.0006 7.3015 18.0006 7.50042Z" fill="#A200F9"/>
          </svg>
        </div>
        <div class="collection-button collection-button-next">
          <svg width="18" height="15" viewBox="0 0 18 15" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M2.09808e-05 7.50042C2.09808e-05 7.69933 0.0790386 7.8901 0.21969 8.03075C0.360342 8.1714 0.551109 8.25042 0.750021 8.25042H15.4397L9.96939 13.7198C9.89971 13.7895 9.84444 13.8722 9.80672 13.9632C9.76901 14.0543 9.7496 14.1519 9.7496 14.2504C9.7496 14.349 9.76901 14.4465 9.80672 14.5376C9.84444 14.6286 9.89971 14.7114 9.96939 14.781C10.0391 14.8507 10.1218 14.906 10.2128 14.9437C10.3039 14.9814 10.4015 15.0008 10.5 15.0008C10.5986 15.0008 10.6961 14.9814 10.7872 14.9437C10.8782 14.906 10.961 14.8507 11.0306 14.781L17.7806 8.03104C17.8504 7.96139 17.9057 7.87867 17.9434 7.78762C17.9812 7.69657 18.0006 7.59898 18.0006 7.50042C18.0006 7.40186 17.9812 7.30426 17.9434 7.21321C17.9057 7.12216 17.8504 7.03945 17.7806 6.96979L11.0306 0.219792C10.8899 0.0790615 10.699 -1.48284e-09 10.5 0C10.301 1.48284e-09 10.1101 0.0790615 9.96939 0.219792C9.82866 0.360523 9.7496 0.551394 9.7496 0.750417C9.7496 0.94944 9.82866 1.14031 9.96939 1.28104L15.4397 6.75042H0.750021C0.551109 6.75042 0.360342 6.82943 0.21969 6.97009C0.0790386 7.11074 2.09808e-05 7.3015 2.09808e-05 7.50042Z" fill="#A200F9"/>
          </svg>
        </div>
      </div>
    </div>

    {% if section.settings.section_button_url != blank %}
      <a href="{{ section.settings.section_button_url }}" title="{{ section.settings.section_button_text }}" class="routine__cta-btn-mobile">
        {{ section.settings.section_button_text }}
      </a>
    {% endif %}
  </div>
</section>


{% schema %}
{
  "name": "Routine",
  "settings": [
    {
      "type": "header",
      "content": "Section Settings"
    },
    {
      "type": "text",
      "id": "section_target",
      "label": "Section Target"
    },
    {
      "type": "color",
      "id": "bg_gradient_1",
      "label": "Gradient top",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "bg_gradient_2",
      "label": "Gradient bottom",
      "default": "#ffffff"
    },

    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "default": 20,
      "label": "Padding top mobile"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "default": 20,
      "label": "Padding bottom mobile"
    },
    {
      "type": "range",
      "id": "padding_top_desk",
      "min": 0,
      "max": 200,
      "step": 5,
      "default": 80,
      "label": "Padding top desktop"
    },
    {
      "type": "range",
      "id": "padding_bottom_desk",
      "min": 0,
      "max": 200,
      "step": 5,
      "default": 80,
      "label": "Padding bottom desktop"
    },
    {
      "type": "header",
      "content": "Section Content"
    },
    {
      "type": "text",
      "id": "section_title_one",
      "label": "Enter title one"
    },
    {
      "type": "text",
      "id": "section_title_two",
      "label": "Enter title two"
    },
    {
      "type": "text",
      "id": "section_button_text",
      "label": "Enter button text"
    },
    {
      "type": "url",
      "id": "section_button_url",
      "label": "Paste URL"
    }
  ],
  "blocks": [
    {
      "name": "Routine",
      "type": "text",
      "settings": [
        {
          "type": "text",
          "id": "routine_title",
          "label": "Enter title"
        },
        {
          "type": "text",
          "id": "routine_time",
          "label": "Enter time"
        },
        {
          "type": "text",
          "id": "routine_text",
          "label": "Enter text"
        },
        {
          "type": "image_picker",
          "id": "routine_img",
          "label": "Upload image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Routine"
    }
  ]
}
{% endschema %}

