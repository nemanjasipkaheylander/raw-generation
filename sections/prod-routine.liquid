    {% if section.settings.section_button_url != blank %}
      <a
        href="{{ section.settings.section_button_url }}"
        title="{{ section.settings.section_button_text }}"
        class="routine__cta-btn-mobile"
      >
        {{ section.settings.section_button_text }}
      </a>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Routine",
  "settings": [
    {
      "type": "header",
      "content": "Section Settings"
    },
    {
      "type": "text",
      "id": "section_target",
      "label": "Section Target"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section background color"
    },
    {
      "type": "color",
      "id": "bg_gradient_1",
      "label": "Section gradient color first"
    },
    {
      "type": "color",
      "id": "bg_gradient_2",
      "label": "Section gradient color second"
    },
    {
      "type": "text",
      "id": "padding_top",
      "label": "Section padding top - small screens"
    },
    {
      "type": "text",
      "id": "padding_bottom",
      "label": "Section padding bottom - small screens"
    },
    {
      "type": "text",
      "id": "padding_top_desk",
      "label": "Section padding top - large screens"
    },
    {
      "type": "text",
      "id": "padding_bottom_desk",
      "label": "Section padding bottom - large screens"
    },
    {
      "type": "header",
      "content": "Section Content"
    },
    {
      "type": "text",
      "id": "section_title_one",
      "label": "Enter title one"
    },
    {
      "type": "text",
      "id": "section_title_two",
      "label": "Enter title two"
    },
    {
      "type": "text",
      "id": "section_button_text",
      "label": "Enter button text"
    },
    {
      "type": "url",
      "id": "section_button_url",
      "label": "Paste URL"
    }
  ],
  "blocks": [
    {
      "name": "Routine",
      "type": "text",
      "settings": [
        {
          "type": "text",
          "id": "routine_title",
          "label": "Enter title"
        },
        {
          "type": "text",
          "id": "routine_time",
          "label": "Enter time"
        },
        {
          "type": "text",
          "id": "routine_text",
          "label": "Enter text"
        },
        {
          "type": "image_picker",
          "id": "routine_img",
          "label": "Upload image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Routine"
    }
  ]
}
{% endschema %}

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const swiper = new Swiper('.routine-swiper', {
      direction: 'horizontal',
      loop: false,
      slidesPerView: 1.2,
      spaceBetween: 20,

      navigation: {
        nextEl: '.collection-button-next',
        prevEl: '.collection-button-prev',
      },

      breakpoints: {
        768: {
          slidesPerView: 2.2,
          spaceBetween: 30,
        },
        1024: {
          slidesPerView: 3,
          spaceBetween: 40,
        },
      },
    });
  });
</script>
