{% liquid
  assign section_target = section.settings.section_target
  assign bg_color = section.settings.bg_color
  assign bg_gradient_1 = section.settings.bg_gradient_1
  assign bg_gradient_2 = section.settings.bg_gradient_2
  assign padding_top = section.settings.padding_top
  assign padding_bottom = section.settings.padding_bottom
  assign padding_top_desk = section.settings.padding_top_desk
  assign padding_bottom_desk = section.settings.padding_bottom_desk
%}

{% style %}
    .routine {
      overflow: hidden;
    }

    .l {
      max-width: 1280px;
      margin: 0 auto;
      padding: 0 20px;
    }

    /* Header */
    .routine__header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 16px;
      margin-bottom: 28px;
    }

    .routine__title {
      font-size: 22px;
      font-weight: 700;
      color: #1a1a1a;
      margin: 0;
      line-height: 1.2;
    }

    .routine__purple {
      color: #9b51e0;
    }

    .routine__header-wrapp{
      display:flex;
      align-items:center;
      gap:4px;
    }

    /* Header right side: arrows + button */
    .routine__header-controls {
      display: flex;
      align-items: center;
      gap: 10px;
    }


  .collection-button {
      border: 1px solid #A200F9;
      border-radius: 10px;
      box-shadow: 0 3px #8216bc;
      color: white;
      cursor: pointer;
      padding: 12px 15px;
      transition: all 0.1s ease-in-out;
  }

  .collection-button.swiper-button-disabled{
      border:1px solid #4C4C4C;
      box-shadow: 0px 3px 0px 0px #4C4C4C;
  }

  .collection-button.swiper-button-disabled path{
      fill:#4C4C4C;
  }

  .swiper-navigation-wrapper{
      display:flex;
      gap:2.4rem;
      justify-content:center;
  }

  .swiper-nav-mob{
    display:flex;
  }

 .swiper-nav-desk{
  display:none;
 }

  .swiper-navigation-wrapper svg{
      fill:none !Important;
  }

      @media (min-width: 767px) {
  .swiper-nav-mob{
    display:none;
  }
 .swiper-nav-desk{
  display:flex;
 }
      }

    .routine__nav-btn {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 40px;
      height: 40px;
      border: 1.5px solid #ccc;
      border-radius: 50%;
      background: #fff;
      cursor: pointer;
      transition: border-color 0.2s, background 0.2s;
      flex-shrink: 0;
    }

    .routine__nav-btn:hover {
      border-color: #9b51e0;
      background: #f8f0ff;
    }

    .routine__nav-btn svg {
      width: 16px;
      height: 16px;
      stroke: #1a1a1a;
    }

    .routine__cta-btn {
      display: inline-block;
      padding: 10px 24px;
      background: #9b51e0;
      color: #fff;
      font-size: 13px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      border-radius: 50px;
      text-decoration: none;
      transition: background 0.2s, transform 0.15s;
      white-space: nowrap;
    }

    .routine__cta-btn:hover {
      background: #7c3dbf;
      transform: translateY(-1px);
    }

    /* Swiper wrapper */
    .routine__content-wrapper {
      position: relative;
      overflow: hidden;
    }

    /* Cards */
    .routine__card {
      background: #fff;
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 2px 12px rgba(0,0,0,0.07);
      display: flex;
      flex-direction: column;
    }

    .routine__image {
      margin: 0;
      aspect-ratio: 16 / 11;
      overflow: hidden;
    }

    .routine__image img,
    .routine__image .routine_img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .routine__header-card {
      padding: 16px;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    /* Time badge */
    .routine__time {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: #f5f0ff;
      border: 1px solid #e5d6ff;
      border-radius: 50px;
      padding: 4px 10px 4px 8px;
      font-size: 12px;
      font-weight: 600;
      color: #1a1a1a;
      width: fit-content;
    }

    .routine__time-icon {
      display: flex;
      align-items: center;
    }

    .routine_title {
      font-size: 12px;
      font-weight: 700;
      color: #9b51e0;
      text-transform: uppercase;
      letter-spacing: 0.06em;
    }

    .routine__content {
      font-size: 13px;
      line-height: 1.6;
      color: #555;
    }

    /* ===========================
       SWIPER OVERRIDES
    =========================== */

    /* Hide default Swiper arrows */
    .routine-swiper .swiper-button-prev,
    .routine-swiper .swiper-button-next {
      display: none !important;
    }

    /* Pagination dots */
    .routine-swiper .swiper-pagination {
      position: relative;
      margin-top: 20px;
      bottom: auto;
    }

    .routine-swiper .swiper-pagination-bullet {
      background: #ccc;
      opacity: 1;
      width: 8px;
      height: 8px;
      transition: background 0.2s, width 0.2s;
      border-radius: 4px;
    }

    .routine-swiper .swiper-pagination-bullet-active {
      background: #9b51e0;
      width: 20px;
    }

    /* ===========================
       MOBILE ADJUSTMENTS
    =========================== */
    @media (max-width: 767px) {
      .routine__title {
        font-size: 18px;
      }

      /* On mobile: hide GET STARTED from header, show full-width below slider */
      .routine__cta-btn-mobile {
        display: block;
        text-align: center;
        margin-top: 20px;
        padding: 14px 24px;
        border-radius: 50px;
        background: #9b51e0;
        color: #fff;
        font-size: 14px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        text-decoration: none;
      }

      .routine__cta-btn-mobile:hover {
        background: #7c3dbf;
      }

      /* Hide desktop CTA from header on mobile */
      .routine__header-controls .routine__cta-btn {
        display: none;
      }
    }

    @media (min-width: 768px) {
      .routine__title {
        font-size: 26px;
      }

      /* Hide mobile CTA on desktop */
      .routine__cta-btn-mobile {
        display: none;
      }
    }
{% endstyle %}

<section class="{{ section.id }} routine" id="{{ section_target }}">
  <div class="l">
    <div class="routine__header">
      <h2 class="routine__title">
