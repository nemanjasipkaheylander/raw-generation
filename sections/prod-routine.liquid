          </svg>
        </div>
      </div>
        {% if section.settings.section_button_url != blank %}
          <a
            href="{{ section.settings.section_button_url }}"
            title="{{ section.settings.section_button_text }}"
            class="routine__cta-btn"
          >
            {{ section.settings.section_button_text }}
          </a>
        {% endif %}
    </div>

    <!-- Swiper -->
    <div class="routine__content-wrapper swiper routine-swiper">
      <div class="swiper-wrapper">
        {% for block in section.blocks %}
          <div class="routine__card swiper-slide" {{ block.shopify_attributes }}>
            <figure class="routine__image">
              {{
                block.settings.routine_img
                | image_url: width: 320
                | image_tag: class: 'routine_img', loading: 'lazy'
              }}
            </figure>
            <div class="routine__header-card">
              <div class="routine__header-wrapp">
                <div class="routine__time">
                  <div class="routine__time-icon">
                    <svg width="15" height="15" viewBox="0 0 15 15" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <g clip-path="url(#clip0_1_622)">
                        <path d="M7.49998 13.9287C11.0504 13.9287 13.9286 11.0506 13.9286 7.50011C13.9286 3.9497 11.0504 1.07153 7.49998 1.07153C3.94958 1.07153 1.07141 3.9497 1.07141 7.50011C1.07141 11.0506 3.94958 13.9287 7.49998 13.9287Z" stroke="#EB51FF" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M7.50044 5.02759V7.50012L5.02747 9.97264" stroke="#EB51FF" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                      </g>
                      <defs>
                        <clipPath id="clip0_1_622">
                          <rect width="15" height="15" fill="white"/>
                        </clipPath>
                      </defs>
                    </svg>
                  </div>
                  {{ block.settings.routine_time }}
                </div>
                <div class="routine_title">{{ block.settings.routine_title }}</div>
              </div>

              <div class="routine__content">
                {{ block.settings.routine_text }}
              </div>
            </div>
          </div>
        {% endfor %}
      </div>

            <div class="swiper-navigation-wrapper swiper-nav-mob">
        <div class="collection-button collection-button-prev">
          <svg
            width="18"
            height="15"
            viewBox="0 0 18 15"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path d="M18.0006 7.50042C18.0006 7.69933 17.9216 7.8901 17.7809 8.03075C17.6403 8.1714 17.4495 8.25042 17.2506 8.25042H2.5609L8.03122 13.7198C8.1009 13.7895 8.15617 13.8722 8.19389 13.9632C8.2316 14.0543 8.25101 14.1519 8.25101 14.2504C8.25101 14.349 8.2316 14.4465 8.19389 14.5376C8.15617 14.6286 8.1009 14.7114 8.03122 14.781C7.96153 14.8507 7.87881 14.906 7.78776 14.9437C7.69672 14.9814 7.59914 15.0008 7.50059 15.0008C7.40204 15.0008 7.30446 14.9814 7.21342 14.9437C7.12237 14.906 7.03965 14.8507 6.96996 14.781L0.219965 8.03104C0.150233 7.96139 0.0949134 7.87867 0.0571702 7.78762C0.019427 7.69657 0 7.59898 0 7.50042C0 7.40186 0.019427 7.30426 0.0571702 7.21321C0.0949134 7.12216 0.150233 7.03945 0.219965 6.96979L6.96996 0.219792C7.1107 0.0790615 7.30157 -1.48284e-09 7.50059 0C7.69961 1.48284e-09 7.89048 0.0790615 8.03122 0.219792C8.17195 0.360523 8.25101 0.551394 8.25101 0.750417C8.25101 0.94944 8.17195 1.14031 8.03122 1.28104L2.5609 6.75042H17.2506C17.4495 6.75042 17.6403 6.82943 17.7809 6.97009C17.9216 7.11074 18.0006 7.3015 18.0006 7.50042Z" fill="#A200F9"/>
          </svg>
        </div>
        <div class="collection-button collection-button-next">
