
{% liquid
  assign section_target = section.settings.section_target
  assign bg_color = section.settings.bg_color
  assign bg_gradient_1 = section.settings.bg_gradient_1
  assign bg_gradient_2 = section.settings.bg_gradient_2
  assign padding_top = section.settings.padding_top
  assign padding_bottom = section.settings.padding_bottom
  assign padding_top_desk = section.settings.padding_top_desk
  assign padding_bottom_desk = section.settings.padding_bottom_desk
%}

{% style %}
/* ===========================
   ROUTINE SECTION
=========================== */

.routine {
  overflow: hidden;
}

.l {
  max-width: 1280px;
  margin: 0 auto;
  padding: 0 20px;
}

/* Header */
.routine__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 16px;
  margin-bottom: 28px;
}

.routine__title {
  font-size: 22px;
  font-weight: 700;
  color: #1a1a1a;
  margin: 0;
  line-height: 1.2;
}

.routine__purple {
  color: #9b51e0;
}

/* Header right side: arrows + button */
.routine__header-controls {
  display: flex;
  align-items: center;
  gap: 10px;
}

.routine__nav-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40px;
  height: 40px;
  border: 1.5px solid #ccc;
  border-radius: 50%;
  background: #fff;
  cursor: pointer;
  transition: border-color 0.2s, background 0.2s;
  flex-shrink: 0;
}

.routine__nav-btn:hover {
  border-color: #9b51e0;
  background: #f8f0ff;
}

.routine__nav-btn svg {
  width: 16px;
  height: 16px;
  stroke: #1a1a1a;
}

.routine__cta-btn {
  display: inline-block;
  padding: 10px 24px;
  background: #9b51e0;
  color: #fff;
  font-size: 13px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  border-radius: 50px;
  text-decoration: none;
  transition: background 0.2s, transform 0.15s;
  white-space: nowrap;
}

.routine__cta-btn:hover {
  background: #7c3dbf;
  transform: translateY(-1px);
}

/* Swiper wrapper */
.routine__content-wrapper {
  position: relative;
  overflow: hidden;
}

/* Cards */
.routine__card {
  background: #fff;
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 2px 12px rgba(0,0,0,0.07);
  display: flex;
  flex-direction: column;
}

.routine__image {
  margin: 0;
  aspect-ratio: 16 / 11;
  overflow: hidden;
}

.routine__image img,
.routine__image .routine_img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.routine__header-card {
  padding: 16px;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

/* Time badge */
.routine__time {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: #f5f0ff;
  border: 1px solid #e5d6ff;
  border-radius: 50px;
  padding: 4px 10px 4px 8px;
  font-size: 12px;
  font-weight: 600;
  color: #1a1a1a;
  width: fit-content;
}

.routine__time-icon {
  display: flex;
  align-items: center;
}

.routine_title {
  font-size: 12px;
  font-weight: 700;
  color: #9b51e0;
  text-transform: uppercase;
  letter-spacing: 0.06em;
}

.routine__content {
  font-size: 13px;
  line-height: 1.6;
  color: #555;
}

/* ===========================
   SWIPER OVERRIDES
=========================== */

/* Hide default Swiper arrows */
.routine-swiper .swiper-button-prev,
.routine-swiper .swiper-button-next {
  display: none !important;
}

/* Pagination dots */
.routine-swiper .swiper-pagination {
  position: relative;
  margin-top: 20px;
  bottom: auto;
}

.routine-swiper .swiper-pagination-bullet {
  background: #ccc;
  opacity: 1;
  width: 8px;
  height: 8px;
  transition: background 0.2s, width 0.2s;
  border-radius: 4px;
}

.routine-swiper .swiper-pagination-bullet-active {
  background: #9b51e0;
  width: 20px;
}

/* ===========================
   MOBILE ADJUSTMENTS
=========================== */
@media (max-width: 767px) {
  .routine__title {
    font-size: 18px;
  }

  /* On mobile: hide GET STARTED from header, show full-width below slider */
  .routine__cta-btn-mobile {
    display: block;
    text-align: center;
    margin-top: 20px;
    padding: 14px 24px;
    border-radius: 50px;
    background: #9b51e0;
    color: #fff;
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    text-decoration: none;
  }

  .routine__cta-btn-mobile:hover {
    background: #7c3dbf;
  }

  /* Hide desktop CTA from header on mobile */
  .routine__header-controls .routine__cta-btn {
    display: none;
  }
}

@media (min-width: 768px) {
  .routine__title {
    font-size: 26px;
  }

  /* Hide mobile CTA on desktop */
  .routine__cta-btn-mobile {
    display: none;
  }
}

{% endstyle %}

<section class="{{ section.id }} routine" id="{{ section_target }}">
  <div class="l">

    <div class="routine__header">
      <h2 class="routine__title">
        {{ section.settings.section_title_one }}
        <span class="routine__purple">{{ section.settings.section_title_two }}</span>
      </h2>

      <div class="routine__header-controls">
        <!-- Prev arrow -->
        <button class="routine__nav-btn routine-prev" aria-label="Previous">
          <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M15 18L9 12L15 6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>

        <!-- Next arrow -->
        <button class="routine__nav-btn routine-next" aria-label="Next">
          <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M9 6L15 12L9 18" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>

        {% if section.settings.section_button_url != blank %}
          <a href="{{ section.settings.section_button_url }}"
             title="{{ section.settings.section_button_text }}"
             class="routine__cta-btn">
            {{ section.settings.section_button_text }}
          </a>
        {% endif %}
      </div>
    </div>

    <!-- Swiper -->
    <div class="routine__content-wrapper swiper routine-swiper">
      <div class="swiper-wrapper">
        {% for block in section.blocks %}
          <div class="routine__card swiper-slide" {{ block.shopify_attributes }}>
            <figure class="routine__image">
              {{ block.settings.routine_img | image_url: width: 320 | image_tag: class: 'routine_img', loading: 'lazy' }}
            </figure>
            <div class="routine__header-card">
              <div class="routine__time">
                <div class="routine__time-icon">
                  <svg width="15" height="15" viewBox="0 0 15 15" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <g clip-path="url(#clip0_1_622)">
                      <path d="M7.49998 13.9287C11.0504 13.9287 13.9286 11.0506 13.9286 7.50011C13.9286 3.9497 11.0504 1.07153 7.49998 1.07153C3.94958 1.07153 1.07141 3.9497 1.07141 7.50011C1.07141 11.0506 3.94958 13.9287 7.49998 13.9287Z" stroke="#EB51FF" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                      <path d="M7.50044 5.02759V7.50012L5.02747 9.97264" stroke="#EB51FF" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </g>
                    <defs>
                      <clipPath id="clip0_1_622">
                        <rect width="15" height="15" fill="white"/>
                      </clipPath>
                    </defs>
                  </svg>
                </div>
                {{ block.settings.routine_time }}
                <div class="routine_title">{{ block.settings.routine_title }}</div>
              </div>
              <div class="routine__content">
                {{ block.settings.routine_text }}
              </div>
            </div>
          </div>
        {% endfor %}
      </div>

      <div class="swiper-pagination"></div>
    </div>

    {% if section.settings.section_button_url != blank %}
      <a href="{{ section.settings.section_button_url }}"
         title="{{ section.settings.section_button_text }}"
         class="routine__cta-btn-mobile">
        {{ section.settings.section_button_text }}
      </a>
    {% endif %}

  </div>
</section>

{% schema %}
  {
    "name": "Routine",
    "settings": [
      {
        "type": "header",
        "content": "Section Settings"
      },
      {
        "type": "text",
        "id": "section_target",
        "label": "Section Target"
      },
      {
        "type": "color",
        "id": "bg_color",
        "label": "Section background color"
      },
      {
        "type": "color",
        "id": "bg_gradient_1",
        "label": "Section gradient color first"
      },
      {
        "type": "color",
        "id": "bg_gradient_2",
        "label": "Section gradient color second"
      },
      {
        "type": "text",
        "id": "padding_top",
        "label": "Section padding top - small screens"
      },
      {
        "type": "text",
        "id": "padding_bottom",
        "label": "Section padding bottom - small screens"
      },
      {
        "type": "text",
        "id": "padding_top_desk",
        "label": "Section padding top - large screens"
      },
      {
        "type": "text",
        "id": "padding_bottom_desk",
        "label": "Section padding bottom - large screens"
      },
      {
        "type": "header",
        "content": "Section Content"
      },
      {
        "type": "text",
        "id": "section_title_one",
        "label": "Enter title one"
      },
      {
        "type": "text",
        "id": "section_title_two",
        "label": "Enter title two"
      },
      {
        "type": "text",
        "id": "section_button_text",
        "label": "Enter button text"
      },
      {
        "type": "url",
        "id": "section_button_url",
        "label": "Paste URL"
      }
    ],
    "blocks": [
      {
        "name": "Routine",
        "type": "text",
        "settings": [
          {
            "type": "text",
            "id": "routine_title",
            "label": "Enter title"
          },
          {
            "type": "text",
            "id": "routine_time",
            "label": "Enter time"
          },
          {
            "type": "text",
            "id": "routine_text",
            "label": "Enter text"
          },
          {
            "type": "image_picker",
            "id": "routine_img",
            "label": "Upload image"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Routine"
      }
    ]
  }
{% endschema %}

<script>
document.addEventListener('DOMContentLoaded', function () {
  const swiper = new Swiper('.routine-swiper', {
    direction: 'horizontal',
    loop: false,
    slidesPerView: 1.2,
    spaceBetween: 20,

    pagination: {
      el: '.swiper-pagination',
      clickable: true,
    },

    navigation: {
      nextEl: '.routine-next',
      prevEl: '.routine-prev',
    },

    breakpoints: {
      768: {
        slidesPerView: 2.2,
        spaceBetween: 30
      },
      1024: {
        slidesPerView: 3,
        spaceBetween: 40
      }
    }
  });
});
</script>
