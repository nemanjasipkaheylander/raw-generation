


{{ '' | asset_url | stylesheet_tag }}

{% liquid
  assign section_target = section.settings.section_target
  assign bg_color = section.settings.bg_color
  assign bg_gradient_1 = section.settings.bg_gradient_1
  assign bg_gradient_2 = section.settings.bg_gradient_2
  assign padding_top = section.settings.padding_top
  assign padding_bottom = section.settings.padding_bottom
  assign padding_top_desk = section.settings.padding_top_desk
  assign padding_bottom_desk = section.settings.padding_bottom_desk
%}

{% style %}
  .{{ section.id }} {
    position: relative;
    background-color: {{ bg_color }};
    background-image: linear-gradient(to bottom, {{ bg_gradient_1 }} 0%, {{ bg_gradient_2 }} 100%);
    padding-top: {{ padding_top }}px;
    padding-bottom: {{ padding_bottom }}px;
  }
  @media (min-width: 768px) {
    .{{ section.id }} {
      padding-top: {{ padding_top_desk }}px;
      padding-bottom: {{ padding_bottom_desk }}px;
    }
  
  }
  /* ============================================================
   CUSTOM ARTICLE SECTION — Full CSS
   Based on Liquid template + design screenshot
   ============================================================ */

/* ── Reset & Base ─────────────────────────────────────────── */
*,
*::before,
*::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

/* ── Layout: Article Shell ────────────────────────────────── */
.hl-article {
  display: flex;
  gap: 20px;
  padding: 20px;
  align-items: flex-start;
  background-color: #f9f9f9;
  font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
  color: #1a1a1a;
  font-size: 16px;
  line-height: 1.7;
}

@media (min-width: 768px) {
  .hl-article {
    gap: 40px;
    padding: 30px 40px;
  }
}

/* ── Table of Contents (Left Sidebar) ────────────────────── */
.hl-article__table-of-content {
  width: 100%;
  flex-direction: column;
  gap: 20px;
  background: #fff;
  border: 1px solid #E6E6E6;
  padding: 20px;
  border-radius: 20px;
  display: none; /* hidden on mobile */
  position: sticky;
  top: 20px;
}

@media (min-width: 768px) {
  .hl-article__table-of-content {
    display: flex;
    max-width: 300px;
    min-width: 220px;
    flex-shrink: 0;
  }
}

.hl-article__table-of-content-title {
  font-size: 13px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: #888;
  margin-bottom: 4px;
}

ol.hl-article__table-of-content-navigation {
  padding-left: 20px;
  display: flex;
  gap: 12px;
  flex-direction: column;
  list-style: none;
  counter-reset: toc-counter;
}

ol.hl-article__table-of-content-navigation li {
  list-style-type: auto;
  font-size: 14px;
  line-height: 1.45;
  color: #444;
}

ol.hl-article__table-of-content-navigation li a {
  color: #444;
  text-decoration: none;
  transition: color 0.2s;
}

ol.hl-article__table-of-content-navigation li a:hover,
ol.hl-article__table-of-content-navigation li.active a {
  color: #A200F9;
}

ol.hl-article__table-of-content-navigation li.active {
  font-weight: 600;
}

/* ── Main Content Column ──────────────────────────────────── */
.hl-article__main-content {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 32px;
}

/* Article hero image */
.hl-article__hero-image {
  width: 100%;
  border-radius: 16px;
  overflow: hidden;
  margin-bottom: 8px;
}

.hl-article__hero-image img {
  width: 100%;
  height: auto;
  display: block;
  object-fit: cover;
}

/* Article meta (date, read time) */
.hl-article__meta {
  display: flex;
  align-items: center;
  gap: 12px;
  font-size: 13px;
  color: #888;
  margin-bottom: 8px;
}

.hl-article__meta-separator {
  width: 4px;
  height: 4px;
  background: #ccc;
  border-radius: 50%;
}

/* Author row */
.hl-article__author-row {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 24px;
}

.hl-article__author-avatar {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  overflow: hidden;
  flex-shrink: 0;
}

.hl-article__author-avatar img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.hl-article__author-text {
  font-size: 13px;
  color: #555;
}

.hl-article__author-text a {
  font-weight: 600;
  color: #A200F9;
  text-decoration: none;
}

.hl-article__author-text a:hover {
  text-decoration: underline;
}

/* ── Article Heading Block ────────────────────────────────── */
.hl-article__article-heading {
  font-size: clamp(24px, 4vw, 36px);
  font-weight: 800;
  line-height: 1.2;
  color: #111;
  margin-bottom: 4px;
}

/* Intro paragraph under heading */
.hl-article__intro-text {
  font-size: 16px;
  line-height: 1.8;
  color: #444;
}

/* ── Highlight / Key Takeaways Block ─────────────────────── */
.hl-article__highlight-content {
  background: #F5EAFF;
  border-radius: 16px;
  padding: 24px 28px;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.hl-article__highlight-header {
  display: flex;
  align-items: center;
  gap: 10px;
}

.hl-article__highlight-icon {
  width: 28px;
  height: 28px;
  flex-shrink: 0;
}

.hl-article__highlight-icon img {
  width: 100%;
  height: auto;
}

.hl-article__highlight-title {
  font-size: 13px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.07em;
  color: #A200F9;
}

.hl-article__highlight-content-body {
  font-size: 15px;
  color: #333;
  line-height: 1.7;
}

.hl-article__highlight-content-body ul {
  padding-left: 18px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.hl-article__highlight-content-body ul li {
  list-style: disc;
}

/* Pro Tip variant */
.hl-article__highlight-content--pro-tip {
  background: #FFF8E6;
  border-left: 4px solid #F5A623;
}

.hl-article__highlight-content--pro-tip .hl-article__highlight-title {
  color: #C47F00;
}

/* Important / Warning variant */
.hl-article__highlight-content--important {
  background: #FFF0F0;
  border-left: 4px solid #E53E3E;
}

.hl-article__highlight-content--important .hl-article__highlight-title {
  color: #C53030;
}

/* ── Paragraph Block ──────────────────────────────────────── */
.hl-article__paragraph {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.hl-article__paragraph-title {
  font-size: clamp(20px, 3vw, 26px);
  font-weight: 700;
  color: #111;
  line-height: 1.3;
  padding-top: 8px;
}

.hl-article__paragraph-subtitle {
  font-size: 18px;
  font-weight: 600;
  color: #222;
  margin-top: 4px;
}

.hl-article__paragraph-content {
  font-size: 15px;
  color: #444;
  line-height: 1.8;
}

.hl-article__paragraph-content p {
  margin-bottom: 14px;
}

.hl-article__paragraph-content p:last-child {
  margin-bottom: 0;
}

.hl-article__paragraph-content a {
  color: #A200F9;
  text-decoration: underline;
}

.hl-article__paragraph-content ul,
.hl-article__paragraph-content ol {
  padding-left: 20px;
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin: 12px 0;
}

.hl-article__paragraph-content ul li {
  list-style: disc;
}

.hl-article__paragraph-content ol li {
  list-style: decimal;
}

/* ── Quiz Divider Block (in-content) ─────────────────────── */
.hl-article__quiz-devider {
  border-radius: 20px;
  border: 1px solid #E6E6E6;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  background: #fff;
}

@media (min-width: 600px) {
  .hl-article__quiz-devider {
    flex-direction: row;
    align-items: stretch;
  }
}

.hl-article__quiz-devider-image {
  flex-shrink: 0;
  max-width: 100%;
}

@media (min-width: 600px) {
  .hl-article__quiz-devider-image {
    max-width: 200px;
  }
}

.hl-article__quiz-devider-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.hl-article__quiz-devider-body {
  padding: 24px;
  display: flex;
  flex-direction: column;
  gap: 10px;
  flex: 1;
}

.hl-article__quiz-devider-tagline {
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: #A200F9;
}

.hl-article__quiz-devider-title {
  font-size: 20px;
  font-weight: 700;
  color: #111;
  line-height: 1.25;
}

.hl-article__quiz-devider-content {
  font-size: 14px;
  color: #555;
  line-height: 1.6;
}

.hl-article__quiz-devider-btn {
  display: inline-block;
  margin-top: 4px;
  padding: 12px 24px;
  background: #A200F9;
  color: #fff;
  font-size: 14px;
  font-weight: 700;
  border-radius: 100px;
  text-decoration: none;
  text-align: center;
  transition: background 0.2s, transform 0.15s;
  align-self: flex-start;
}

.hl-article__quiz-devider-btn:hover {
  background: #8500cc;
  transform: translateY(-1px);
}

/* ── Accordion (Disclaimer & Sources) ────────────────────── */
.hl-article__accordion-wrapper {
  border: 1px solid #E6E6E6;
  border-radius: 16px;
  overflow: hidden;
  background: #fff;
}

.hl-article__accordion-title-wrapper {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 18px 20px;
  cursor: pointer;
  user-select: none;
}

.hl-article__accordion-icon {
  width: 28px;
  height: 28px;
  flex-shrink: 0;
}

.hl-article__accordion-icon img {
  width: 100%;
  height: auto;
}

.hl-article__accordion-title {
  font-size: 15px;
  font-weight: 600;
  color: #222;
}

.hl-article__accordion-content {
  padding: 0 20px 20px;
  font-size: 14px;
  color: #555;
  line-height: 1.7;
  display: none; /* toggled open by JS */
}

.hl-article__accordion-wrapper.is-open .hl-article__accordion-content {
  display: block;
}

/* Sources block specific layout */
.hl-article__accordion-content {
  display: flex;
  gap: 16px;
  align-items: flex-start;
}

.hl-article__accordion-author-image {
  flex-shrink: 0;
}

.hl-article__accordion-author-image figure {
  width: 56px;
  height: 56px;
  border-radius: 50%;
  overflow: hidden;
}

.hl-article__accordion-author-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.hl-article__accordion-main-content {
  display: flex;
  flex-direction: column;
  gap: 4px;
  flex: 1;
}

.hl-article__accordion-main-content-title {
  font-size: 15px;
  font-weight: 700;
  color: #111;
}

.hl-article__accordion-main-content-subtitle {
  font-size: 13px;
  color: #888;
}

.hl-article__accordion-main-content-text {
  font-size: 14px;
  color: #444;
  line-height: 1.65;
  margin-top: 8px;
}

.hl-article__accordion-main-content-link a {
  font-size: 13px;
  font-weight: 600;
  color: #A200F9;
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  gap: 4px;
  margin-top: 6px;
}

.hl-article__accordion-main-content-link a:hover {
  text-decoration: underline;
}

/* LinkedIn icon in accordion side */
.hl-article__accordion-side-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 18px;
  flex-shrink: 0;
}

/* Toggle chevron */
.hl-article__accordion-title-wrapper::after {
  content: '';
  display: block;
  width: 10px;
  height: 10px;
  border-right: 2px solid #888;
  border-bottom: 2px solid #888;
  transform: rotate(45deg);
  margin-left: auto;
  transition: transform 0.25s;
}

.hl-article__accordion-wrapper.is-open .hl-article__accordion-title-wrapper::after {
  transform: rotate(-135deg);
}

/* ── Right Sidebar ────────────────────────────────────────── */
.hl-article__side-info {
  width: 100%;
  flex-direction: column;
  gap: 20px;
  display: flex;
}

@media (min-width: 768px) {
  .hl-article__side-info {
    max-width: 280px;
    min-width: 220px;
    flex-shrink: 0;
    position: sticky;
    top: 20px;
  }
}

/* Author card */
.hl-article__side-info-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #fff;
  padding: 20px;
  gap: 10px;
  border: 1px solid #E6E6E6;
  border-radius: 20px;
  text-align: center;
}

figure.hl-article__side-info-image {
  max-width: 60px;
  width: 60px;
  height: 60px;
  border-radius: 50%;
  overflow: hidden;
}

figure.hl-article__side-info-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.hl-article__side-info-name {
  font-size: 15px;
  font-weight: 700;
  color: #111;
  line-height: 1.3;
}

.hl-article__side-info-title {
  font-size: 13px;
  color: #888;
  line-height: 1.4;
}

.hl-article__side-info-linkedin {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 13px;
  font-weight: 600;
  color: #0A66C2;
  text-decoration: none;
  margin-top: 4px;
}

.hl-article__side-info-linkedin:hover {
  text-decoration: underline;
}

/* Quiz card (sidebar) */
.hl-article__side-info-quiz-card {
  border-radius: 20px;
  border: 1px solid #E6E6E6;
  overflow: hidden;
  background: #fff;
}

.hl-article__side-info-quiz-card-image {
  width: 100%;
  overflow: hidden;
  max-height: 160px;
}

.hl-article__side-info-quiz-card-image img {
  width: 100%;
  height: 160px;
  object-fit: cover;
  display: block;
}

.hl-article_side-info-wrapp {
  padding: 20px;
  display: flex;
  gap: 12px;
  flex-direction: column;
}

.hl-article__side-info-quiz-tagline {
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: #A200F9;
}

.hl-article__side-info-quiz-title {
  font-size: 17px;
  font-weight: 700;
  color: #111;
  line-height: 1.25;
}

.hl-article__side-info-quiz-content {
  font-size: 13px;
  color: #555;
  line-height: 1.6;
}

.hl-article__side-info-quiz-btn {
  display: block;
  width: 100%;
  padding: 13px 20px;
  background: #A200F9;
  color: #fff;
  font-size: 14px;
  font-weight: 700;
  border-radius: 100px;
  text-decoration: none;
  text-align: center;
  transition: background 0.2s, transform 0.15s;
}

.hl-article__side-info-quiz-btn:hover {
  background: #8500cc;
  transform: translateY(-1px);
}

/* ── Breadcrumb ───────────────────────────────────────────── */
.hl-article__breadcrumb {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 13px;
  color: #888;
  flex-wrap: wrap;
  margin-bottom: 8px;
}

.hl-article__breadcrumb a {
  color: #888;
  text-decoration: none;
}

.hl-article__breadcrumb a:hover {
  color: #A200F9;
}

.hl-article__breadcrumb-separator {
  font-size: 11px;
  color: #bbb;
}

.hl-article__breadcrumb-current {
  color: #444;
  font-weight: 500;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 200px;
}

/* ── Utility / Global Helpers ─────────────────────────────── */
.visually-hidden {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  overflow: hidden;
  clip: rect(0,0,0,0);
  white-space: nowrap;
  border: 0;
}

/* ── Print ────────────────────────────────────────────────── */
@media print {
  .hl-article__side-info,
  .hl-article__table-of-content {
    display: none !important;
  }

  .hl-article {
    padding: 0;
  }

  .hl-article__main-content {
    width: 100%;
  }
}
{% endstyle %}

<section class="{{ section.id }} hl-article" id="{{ section_target }}">
    <div class="hl-article__table-of-content">
        <div class="hl-article__table-of-content-title">{{ section.settings.toc_title }}</div>
        <ol class="hl-article__table-of-content-navigation">
             {% render 'hl-snippet-article-toc'  tableContent: section.blocks %}
        </ol>
        
    </div>
    <div class="hl-article__main-content">
         {% render 'hl-snippet-article-content' artContent: section.blocks  article: article %}

         {% if article.metafields.custom.disclaimer_title %}
                <div class="hl-article__accordion-wrapper">
                      <div class="hl-article__accordion-title-wrapper">
                           <figure class="hl-article__accordion-icon">
                             {{ article.metafields.custom.disclaimer_icon | image_url: width: 2000 | image_tag: class: 'accordion-icon', loading: 'lazy' }}
                           </figure>
                           <h3 class="hl-article__accordion-title">{{ article.metafields.custom.disclaimer_title }}</h3>
                      </div>
                      <div class="hl-article__accordion-content">{{ article.metafields.custom.disclaimer_content }}</div>
                </div>
         {% endif %}

         {% if article.metafields.custom.sources_title %}
                <div class="hl-article__accordion-wrapper">
                      <div class="hl-article__accordion-title-wrapper">
                           <figure class="hl-article__accordion-icon">
                             {{ article.metafields.custom.sources_icon | image_url: width: 2000 | image_tag: class: 'accordion-icon', loading: 'lazy' }}
                           </figure>
                           <h3 class="hl-article__accordion-title">{{ article.metafields.custom.sources_title }}</h3>
                      </div>
                      <div class="hl-article__accordion-content">
                            <div class="hl-article__accordion-author-image">
                                <figure>
                                    {{ article.metafields.custom.sources_author_image | image_url: width: 2000 | image_tag: class: 'accordion-icon', loading: 'lazy' }}
                                </figure>
                            </div>
                            <div class="hl-article__accordion-main-content">
                                  <div class="hl-article__accordion-main-content-title">
                                     {{ article.metafields.custom.sources_author_name }}
                                  </div>
                                  <div class="hl-article__accordion-main-content-subtitle">
                                      {{ article.metafields.custom.source_author_job_title }}
                                  </div>
                                  <div class="hl-article__accordion-main-content-text">
                                       {{ article.metafields.custom.source_author_content }}
                                  </div>
                                  <div class="hl-article__accordion-main-content-link">
                                        {% if article.metafields.custom.source_author_url %}
                                             <a href="{{article.metafields.custom.source_author_url}}" title="{{ article.metafields.custom.source_author_url_text }}">{{ article.metafields.custom.source_author_url_text }}</a>
                                        {% endif %}
                                  </div>
                            </div>
                      </div>
                      <div class="hl-article__accordion-side-icon">
                          <svg width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                          <path d="M24 16.0005C25.5913 16.0005 27.1174 16.6326 28.2426 17.7578C29.3679 18.8831 30 20.4092 30 22.0005V29.0005H26V22.0005C26 21.4701 25.7893 20.9613 25.4142 20.5863C25.0391 20.2112 24.5304 20.0005 24 20.0005C23.4696 20.0005 22.9609 20.2112 22.5858 20.5863C22.2107 20.9613 22 21.4701 22 22.0005V29.0005H18V22.0005C18 20.4092 18.6321 18.8831 19.7574 17.7578C20.8826 16.6326 22.4087 16.0005 24 16.0005ZM10 17.0005H14V29.0005H10V17.0005Z" stroke="#A200F9" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                          <path d="M12 14.0005C13.1046 14.0005 14 13.1051 14 12.0005C14 10.8959 13.1046 10.0005 12 10.0005C10.8954 10.0005 10 10.8959 10 12.0005C10 13.1051 10.8954 14.0005 12 14.0005Z" stroke="#A200F9" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                          </svg>

                      </div>
                </div>
         {% endif %}
    </div>
    <div class="hl-article__side-info">
        {% render 'hl-snippet-article-side-info'  sideInfo: section.blocks %}
    </div>
</section>

{% comment %} <script src='{{ '' | asset_url }}' defer='defer'></script> {% endcomment %}

{% schema %}
  {
    "name": "Custom Article",
    "settings": [
      {
        "type": "header",
        "content": "Section Settings"
      },
      {
        "type": "text",
        "id": "section_target",
        "label": "Section Target"
      },
      {
        "type": "color",
        "id": "bg_color",
        "label": "Section background color"
      },
      {
        "type": "color",
        "id": "bg_gradient_1",
        "label": "Section gradient color first"
      }, {
        "type": "color",
        "id": "bg_gradient_2",
        "label": "Section gradient color second"
      },
      {
        "type": "text",
        "id": "padding_top",
        "label": "Section padding top - small screens"
      }, {
        "type": "text",
        "id": "padding_bottom",
        "label": "Section padding bottom - small screens"
      }, {
        "type": "text",
        "id": "padding_top_desk",
        "label": "Section padding top - large screens"
      }, {
        "type": "text",
        "id": "padding_bottom_desk",
        "label": "Section padding bottom - large screens"
      },
      {
        "type": "header",
        "content": "Section Content"
      },
      {
        "type": "text",
        "id": "toc_title",
        "label": "Enter toc title",
        "default": "Contents"
      }
    ],
    "blocks": [
           {
                "name": "Headlines",
                "type": "table-of-content",
                "settings": [
                          {
