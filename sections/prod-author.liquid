



{{ '' | asset_url | stylesheet_tag }}

{% liquid
  assign section_target = section.settings.section_target
  assign bg_color = section.settings.bg_color
  assign bg_gradient_1 = section.settings.bg_gradient_1
  assign bg_gradient_2 = section.settings.bg_gradient_2
  assign padding_top = section.settings.padding_top
  assign padding_bottom = section.settings.padding_bottom
  assign padding_top_desk = section.settings.padding_top_desk
  assign padding_bottom_desk = section.settings.padding_bottom_desk
%}

{% style %}
  .{{ section.id }} {
    position: relative;
    background-color: {{ bg_color }};
    background-image: linear-gradient(to bottom, {{ bg_gradient_1 }} 0%, {{ bg_gradient_2 }} 100%);
    padding-top: {{ padding_top }}px;
    padding-bottom: {{ padding_bottom }}px;
  }
  @media (min-width: 768px) {
    .{{ section.id }} {
      padding-top: {{ padding_top_desk }}px;
      padding-bottom: {{ padding_bottom_desk }}px;
    }
  }
{% endstyle %}

<section class="{{ section.id }}" class="text-with-image" id="{{ section_target }}">
    <div class="l">
        <div class="text-with-image__wrapper">
          <div class="text-with-image__right-side">
              <div class="text-with-image__tagline">{{ section.settings.section_tagline }}</div>
              <h2 class="text-with-image__title">{{ section.settings.section_title }}</h2>
              <p class="text-with-image__content-one">{{ section.settings.section_content_one }}</p>
              <p class="text-with-image__content-two">{{ section.settings.section_content_two }}</p>

              {% if section.settings.section_button_url != blank %}
                <div class="text-with-image__button">
                   <a href="{{ section.settings.section_button_url }}" title="{{ section.settings.section_button_text }}">{{ section.settings.section_button_text }}</a>
                </div>
              {% endif %}
              <p class="text-with-image__button-after">{{ section.settings.section_after_button }}</p>
          </div> 
           
          <div class="text-with-image__image-container">
             <figure class="text-with-image__image">
                {{ section.settings.section_image | image_url: width: 2000 | image_tag: class: 'main_author_img', loading: 'lazy' }}
             </figure>
          </div>
        </div>
          <div class="faq__button-mob">
                   <a href="{{ section.settings.section_button_url }}" title="{{ section.settings.section_button_text }}">{{ section.settings.section_button_text }}</a>
          </div>
    </div>
</section>

{% comment %} <script src='{{ '' | asset_url }}' defer='defer'></script> {% endcomment %}

<style>
  .text-with-image__tagline {
    font-family: "Jost", sans-serif;
    font-weight: 400;
    font-size: 21px;
    line-height: 1.4;
    color: #a200f9;
}

h2.text-with-image__title {
    font-family: "Jost", sans-serif;
    font-weight: 600;
    font-size: 24px;
    line-height: 1.4;
    text-transform: uppercase;
    color: #000;
}

p.text-with-image__content-one {
    font-family: "Jost", sans-serif;
    font-weight: 400;
    font-size: 18px;
    line-height: 1.4;
    color: #434343;
}

p.text-with-image__content-two {
    box-shadow: 2px 3px 0 0 #c4a7d3;
    background: #ead5f5;
    border: 1px solid #a1a1a1;
    border-radius: 10px;
    padding: 24px 16px;
    font-family: "Jost", sans-serif;
    font-weight: 400;
    font-size: 18px;
    /* line-height: 25px; */
    line-height: 1.4;
    color: #434343;
}

.text-with-image__button a {
    border: 1px solid #a548d8;
    border-radius: 10px;
    padding: 8px 24px;
    box-shadow: 0 3px 0 0 #8216bc;
    background: #a200f9;
    font-family: "Jost", sans-serif;
    font-weight: 600;
    font-size: 18px;
    line-height: 1.4;
    text-transform: uppercase;
    color: #fdfcfe;
    display: inline-block;
    text-align: center;
}

p.text-with-image__button-after {
    font-family: "Jost", sans-serif;
    font-weight: 400;
    font-size: 15px;
    line-height: 1.4;
    text-align: center;
    color: #000;
}

figure.text-with-image__image {
    box-shadow: 8px 8px 0 0 #e4d5ed;
    border-radius: 16px;
}
.text-with-image__wrapper {
    display: flex;
    gap: 64px;
    align-items: center;
    justify-content: center;
}

.text-with-image__right-side {
    max-width: 560px;
    display: flex;
    flex-direction: column;
    gap: 16px;
}

.text-with-image__image-container {
    max-width: 565px;
}

.text-with-image__button {
    display: flex;
    flex-direction: column;
    justify-content: center;
}
</style>

