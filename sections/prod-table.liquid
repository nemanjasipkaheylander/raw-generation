            </span>
          {% else %}
            <span class="comparison-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none">
                <circle cx="12" cy="12" r="10" fill="#C94747"></circle>
                <path d="M8.7 8.7L15.3 15.3" stroke="#ffffff" stroke-width="2" stroke-linecap="round"></path>
                <path d="M15.3 8.7L8.7 15.3" stroke="#ffffff" stroke-width="2" stroke-linecap="round"></path>
              </svg>
            </span>
          {% endif %}

          {% if block.settings.column_1_note != blank %}
            <div class="comparison-note">{{ block.settings.column_1_note }}</div>
          {% endif %}
        </div>
      </div>
    {% endfor %}
  </div>
</div>
        <div class="comparison-column comparison-column--third">
          <div class="comparison-column__head">
            {{ section.settings.column_2_title }}
          </div>

          <div class="comparison-card">
            {% for block in section.blocks %}
              <div class="comparison-row" {{ block.shopify_attributes }}>
                <div class="comparison-icon-wrap">
                  {% if block.settings.column_2_status == 'check' %}
                    <span class="comparison-icon" aria-hidden="true">
                      <svg viewBox="0 0 24 24" fill="none">
                        <path d="M12 1.8L14.65 4.14L18.14 3.86L18.86 7.35L21.2 10L18.86 12.65L19.14 16.14L15.65 16.86L13 19.2L10.35 16.86L6.86 17.14L6.14 13.65L3.8 11L6.14 8.35L5.86 4.86L9.35 4.14L12 1.8Z" fill="#49A347"></path>
                        <path d="M8.7 11.9L10.9 14.1L15.3 9.7" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
                      </svg>
                    </span>
                  {% else %}
                    <span class="comparison-icon" aria-hidden="true">
                      <svg viewBox="0 0 24 24" fill="none">
                        <circle cx="12" cy="12" r="10" fill="#C94747"></circle>
                        <path d="M8.7 8.7L15.3 15.3" stroke="#ffffff" stroke-width="2" stroke-linecap="round"></path>
                        <path d="M15.3 8.7L8.7 15.3" stroke="#ffffff" stroke-width="2" stroke-linecap="round"></path>
                      </svg>
                    </span>
                  {% endif %}

                  {% if block.settings.column_2_note != blank %}
                    <div class="comparison-note">{{ block.settings.column_2_note }}</div>
                  {% endif %}
                </div>
              </div>
            {% endfor %}
          </div>
        </div>

        <div class="comparison-column comparison-column--fourth">
          <div class="comparison-column__head">
            {{ section.settings.column_3_title }}
          </div>

          <div class="comparison-card">
            {% for block in section.blocks %}
              <div class="comparison-row" {{ block.shopify_attributes }}>
                <div class="comparison-icon-wrap">
                  {% if block.settings.column_3_status == 'check' %}
                    <span class="comparison-icon" aria-hidden="true">
                      <svg viewBox="0 0 24 24" fill="none">
                        <path d="M12 1.8L14.65 4.14L18.14 3.86L18.86 7.35L21.2 10L18.86 12.65L19.14 16.14L15.65 16.86L13 19.2L10.35 16.86L6.86 17.14L6.14 13.65L3.8 11L6.14 8.35L5.86 4.86L9.35 4.14L12 1.8Z" fill="#49A347"></path>
                        <path d="M8.7 11.9L10.9 14.1L15.3 9.7" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
                      </svg>
                    </span>
                  {% else %}
                    <span class="comparison-icon" aria-hidden="true">
                      <svg viewBox="0 0 24 24" fill="none">
                        <circle cx="12" cy="12" r="10" fill="#C94747"></circle>
                        <path d="M8.7 8.7L15.3 15.3" stroke="#ffffff" stroke-width="2" stroke-linecap="round"></path>
                        <path d="M15.3 8.7L8.7 15.3" stroke="#ffffff" stroke-width="2" stroke-linecap="round"></path>
                      </svg>
                    </span>
                  {% endif %}

                  {% if block.settings.column_3_note != blank %}
                    <div class="comparison-note">{{ block.settings.column_3_note }}</div>
                  {% endif %}
                </div>
              </div>
            {% endfor %}
          </div>
        </div>

        {% if show_column_5 %}
          <div class="comparison-column comparison-column--fifth">
            <div class="comparison-column__head">
              {{ section.settings.column_4_title }}
            </div>

            <div class="comparison-card">
              {% for block in section.blocks %}
                <div class="comparison-row" {{ block.shopify_attributes }}>
                  <div class="comparison-icon-wrap">
                    {% if block.settings.column_4_status == 'check' %}
                      <span class="comparison-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none">
                          <path d="M12 1.8L14.65 4.14L18.14 3.86L18.86 7.35L21.2 10L18.86 12.65L19.14 16.14L15.65 16.86L13 19.2L10.35 16.86L6.86 17.14L6.14 13.65L3.8 11L6.14 8.35L5.86 4.86L9.35 4.14L12 1.8Z" fill="#49A347"></path>
