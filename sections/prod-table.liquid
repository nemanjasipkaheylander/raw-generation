                        </svg>
                      </span>
                    {% else %}
                      <span class="comparison-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none">
                          <circle cx="12" cy="12" r="10" fill="#C94747"></circle>
                          <path d="M8.7 8.7L15.3 15.3" stroke="#ffffff" stroke-width="2" stroke-linecap="round"></path>
                          <path d="M15.3 8.7L8.7 15.3" stroke="#ffffff" stroke-width="2" stroke-linecap="round"></path>
                        </svg>
                      </span>
                    {% endif %}

                    {% if block.settings.column_4_note != blank %}
                      <div class="comparison-note">{{ block.settings.column_4_note }}</div>
                    {% endif %}
                  </div>
                </div>
              {% endfor %}
            </div>
          </div>
        {% endif %}

      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Comparison Table",
  "settings": [
    {
      "type": "text",
      "id": "section_target",
      "label": "Section anchor"
    },
          {
        "type": "text",
        "id": "section_title_one",
        "label": "Enter title first word",
        "default":"How Does the Protein Cleanse?"
      },
      {
        "type": "text",
        "id": "section_title_two",
        "label": "Enter title highlighted word",
        "default": "Compare"
      },
      {
        "type": "text",
        "id": "section_title_third",
        "label": "Enter title rest"
      },
    {
      "type": "text",
      "id": "feature_heading",
      "label": "Feature column title",
      "default": "Feature"
    },
    {
      "type": "text",
      "id": "column_1_title",
      "label": "Column 1 title (sticky highlight)",
      "default": "Protein Cleanse"
    },
    {
      "type": "text",
      "id": "column_2_title",
      "label": "Column 2 title",
      "default": "Restrictive Crash Diets"
    },
    {
      "type": "text",
      "id": "column_3_title",
      "label": "Column 3 title",
      "default": "DIY Home Juicing"
    },
    {
      "type": "checkbox",
      "id": "show_column_5",
      "label": "Show extra comparison column",
      "default": false
    },
    {
      "type": "text",
      "id": "column_4_title",
      "label": "Extra column title",
      "default": "Optional Column"
    },
    {
      "type": "color",
