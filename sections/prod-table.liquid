{% liquid
  assign section_target = section.settings.section_target
  assign show_column_5 = section.settings.show_column_5
%}

{% style %}
  .comparison-{{ section.id }} {
    background: linear-gradient(to bottom, {{ section.settings.bg_gradient_1 }}, {{ section.settings.bg_gradient_2 }});
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    overflow: hidden;
    font-family:"Jost";
  }
.comparison-table {
    font-family: "Jost";
    font-weight:400;
}

.comparison-column__head {
    font-weight: 500 !important;
}
  .comparison__title-container{
    width:100%;
  }
  .title-comparison{
    text-align:center;
    font-size:1.75rem;
    line-height:130%;
    color:#fff;
    margin-bottom:1.86rem;
  }
  @media (min-width: 768px) {
    .comparison-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_desk }}px;
      padding-bottom: {{ section.settings.padding_bottom_desk }}px;
    }
      .title-comparison{
    font-size:2.75rem;
        margin-bottom:2.75rem;

  }
  }

  .comparison-{{ section.id }} .comparison-wrapper {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 16px;
  }

  .comparison-{{ section.id }} .comparison-scroll {
    overflow-x: auto;
    overflow-y: visible;
    -webkit-overflow-scrolling: touch;
    padding-bottom: 8px;
  }

  .comparison-{{ section.id }} .comparison-table {
    display: grid;
    align-items: self-start;
        justify-content:center;
    position: relative;
    min-width: {% if show_column_5 %}1160px{% else %}920px{% endif %};
    grid-template-columns: 340px 286px 285px 285px
      {% if show_column_5 %}240px{% endif %};
  }

  .comparison-{{ section.id }} .comparison-column {
    position: relative;
  }

  .comparison-card--highlight .comparison-column__head {
    color: #000 !important;
  }

  .comparison-card.comparison-card--highlight {
    border-radius: 20px;
}
.comparison-column--feature .comparison-card {
    border-radius: 20px 0 0 20px !important;
}

.comparison-column:last-of-type  .comparison-card {
    border-radius: 0 20px 20px 0 !important;
}

  .comparison-{{ section.id }} .comparison-column__head {
    min-height: 100px;
    padding: 24px 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    font-weight: 700;
    font-size: 20px;
    line-height: 1.35;
    color: #ffffff;
  }

  .comparison-{{ section.id }} .comparison-column--feature .comparison-column__head {
    justify-content: flex-start;
    text-align: left;
  }

  .comparison-{{ section.id }} .comparison-card {
    background: #f3f3f3;
    overflow: hidden;
    position: relative;
  }

  .comparison-{{ section.id }} .comparison-card--highlight {
    background: #e9d3ea;
    box-shadow: 5px 8px 0 rgba(125, 77, 118, 0.45);
    padding-bottom:30px;
  }


.comparison-row.comparison-row--feature {
    padding: 2px 10px;
}
  @media (max-width: 767px) {
.comparison-row.comparison-row--feature {
    padding: 14px;
}  }
  .comparison-{{ section.id }} .comparison-row {
    min-height: 72px;
    padding: 14px;
    border-top: 1px solid #dddddd;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
  }
  .comparison-card--highlight .comparison-row {
    border: unset;
  }
  .comparison-{{ section.id }} .comparison-card .comparison-row:first-child {
    border-top: 0;
  }

  .comparison-{{ section.id }} .comparison-row--feature {
    justify-content: flex-start;
    text-align: left;
    color: #4c4c4c;
    font-size: 15px;
    line-height: 1.35;
  }

  .comparison-{{ section.id }} .comparison-column--highlight .comparison-row {
    border-color: rgba(0, 0, 0, 0.06);
  }

  .comparison-{{ section.id }} .comparison-icon-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
  }

  .comparison-{{ section.id }} .comparison-icon {
    width: 22px;
    height: 22px;
    display: block;
    flex: 0 0 auto;
  }

  .comparison-{{ section.id }} .comparison-icon svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .comparison-{{ section.id }} .comparison-note {
    font-size: 12px;
    line-height: 1.25;
    color: #4c4c4c;
  }

  @media (max-width: 767px) {
    .comparison-{{ section.id }} .comparison-wrapper {
      padding: 0 8px;
    }

    .comparison-{{ section.id }} .comparison-scroll {
      overflow-x: auto;
      overflow-y: visible;
      padding-bottom: 10px;
    }

    .comparison-{{ section.id }} .comparison-table {
      min-width: {% if show_column_5 %}700px{% else %}545px{% endif %};
      grid-template-columns:
        115px
        120px
        155px
        155px
        {% if show_column_5 %}155px{% endif %};
    }

    .comparison-{{ section.id }} .comparison-column__head {
      min-height: 100px;
      padding: 18px 8px;
      font-size: 14px;
      line-height: 1.4;
    }

    .comparison-{{ section.id }} .comparison-card {
      border-radius: ;
    }

    .comparison-{{ section.id }} .comparison-column--highlight {

    }

    .comparison-{{ section.id }} .comparison-card--highlight {
      box-shadow: 8px 6px 0 rgba(125, 77, 118, 0.45);
    }

    .comparison-{{ section.id }} .comparison-row {
      min-height: 78px;
      padding: 12px 4px;
    }

    .comparison-{{ section.id }} .comparison-row--feature {
      font-size: 12px;
      line-height: 1.35;
    }

    .comparison-{{ section.id }} .comparison-note {
      font-size: 11px;
      line-height: 1.2;
    }

    .comparison-{{ section.id }} .comparison-column--feature {
      position: sticky;
      left: 0;
      z-index: 6;
    }

    .comparison-{{ section.id }} .comparison-column--feature .comparison-column__head {
      background: linear-gradient(to bottom, {{ section.settings.bg_gradient_1 }}, {{ section.settings.bg_gradient_2 }});
    }

    .comparison-{{ section.id }} .comparison-column--feature .comparison-card {
      background: #f3f3f3;
      border-top-right-radius: 0;
      border-bottom-right-radius: 0;
    }

    .comparison-{{ section.id }} .comparison-column--highlight {
      position: sticky;
      left: 115px;
      z-index: 7;
    }

    .comparison-{{ section.id }} .comparison-column--highlight .comparison-column__head {
      background: #e9d3ea;
      color: #111111;
      border-top-left-radius: 16px;
      border-top-right-radius: 16px;
    }

    .comparison-{{ section.id }} .comparison-column--third,
    .comparison-{{ section.id }} .comparison-column--fourth,
    .comparison-{{ section.id }} .comparison-column--fifth {
      z-index: 1;
    }
  }
{% endstyle %}

<section class="comparison-{{ section.id }}" id="{{ section_target }}">
  <div class="comparison-wrapper">

        <div class="icon-list__title-container">
            <h2 class="title-comparison">{{ section.settings.section_title_one }} <strong>{{ section.settings.section_title_two }}</strong> <span>{{ section.settings.section_title_third }}</span></h2>
        </div>
    <div class="comparison-scroll">
      <div class="comparison-table">

        <div class="comparison-column comparison-column--feature">
          <div class="comparison-column__head">
            {{ section.settings.feature_heading }}
          </div>

          <div class="comparison-card">
            {% for block in section.blocks %}
              <div class="comparison-row comparison-row--feature" {{ block.shopify_attributes }}>
                {{ block.settings.feature_label }}
              </div>
            {% endfor %}
          </div>
        </div>
<div class="comparison-column comparison-column--highlight">
  <div class="comparison-card comparison-card--highlight">
    
    {% comment %} Naslov koji je sada unutar kartice kao prvi element {% endcomment %}
    <div class="comparison-column__head first-box-title">
      {{ section.settings.column_1_title }}
    </div>

    {% for block in section.blocks %}
