


{{ 'mega-menu-one.css' | asset_url | stylesheet_tag }}

{% liquid
  assign section_target = section.settings.section_target
  assign bg_color = section.settings.bg_color
  assign bg_gradient_1 = section.settings.bg_gradient_1
  assign bg_gradient_2 = section.settings.bg_gradient_2
  assign padding_top = section.settings.padding_top
  assign padding_bottom = section.settings.padding_bottom
  assign padding_top_desk = section.settings.padding_top_desk
  assign padding_bottom_desk = section.settings.padding_bottom_desk
%}

{% style %}
  .{{ section.id }} {
    position: relative;
    background-color: {{ bg_color }};
    background-image: linear-gradient(to bottom, {{ bg_gradient_1 }} 0%, {{ bg_gradient_2 }} 100%);
    padding-top: {{ padding_top }}px;
    padding-bottom: {{ padding_bottom }}px;
  }
  @media (min-width: 768px) {
    .{{ section.id }} {
      padding-top: {{ padding_top_desk }}px;
      padding-bottom: {{ padding_bottom_desk }}px;
    }
  }
{% endstyle %}

<section class="{{ section.id }} mega-menu-one" id="{{ section_target }}">
   <div class="l menu-wrapper">
      {% if section.blocks.size > 0 %}
         <div class="mega-menu-one__container-one">
           <div class="mega-menu-one__content">
              <div class="mega-menu-one__column_title">{{ section.settings.column_title_one }}</div>
              <div class="mega-menu-one__products">
                  {% for block in section.blocks %}
                    <div class="mega-menu-one__product-card">
                        <div class="mega-menu-one__product-label" style="background-color: {{ block.settings.mmo_label_color }};">{{ block.settings.mmo_label_text}}</div>
                        <a href="{{ block.settings.mmo_product.url }}" title="{{block.settings.mmo_product.title}}">
                        <figure class="mega-menu-one__product-image">
                          {{ block.settings.mmo_image | image_url: width: 320 | image_tag: class: 'meganav__gallery__img_product', loading: 'lazy' }}
                        </figure>
                        <h2 class="mega-menu-one__product-title">{{ block.settings.mmo_product_title}}</h2>
                        <p class="mega-menu-one__product-subtitle">{{ block.settings.mmo_product_subtitle}}</p>
                        </a>
                    </div>
                  {% endfor %}
                </div>
            </div>
           </div> 
      {% endif %}
           <div class="mega-menu-one__container-two">
             <div class="mega-menu-one__column_title">{{ section.settings.column_title_two }}</div>
             {% if section.settings.column_two_links != blank %}
              {% assign menu_handle = section.settings.column_two_links %}
              {% assign menu = linklists[menu_handle] %}

              {% if menu.links.size > 0 %}
                <ul class="mega-menu-one__custom-menu">
                  {% for link in menu.links %}
                    <li class="mega-menu-one__custom-menu-item">
                      <a href="{{ link.url }}" class="mega-menu-one__custom-menu-link">
                        {{ link.title }}
                      </a>
                    </li>
                  {% endfor %}
                </ul>
              {% endif %}
            {% endif %}
          </div>
          <div class="mega-menu-one__container-three">
            <div class="mega-menu-one__column_title">{{ section.settings.column_title_third }}</div>
            <div class="mega-menu-one__container-box">
            <figure class="mega-menu-one__image">
                     {{ section.settings.column_third_image | image_url: width: 1040 | image_tag: class: 'meganav__img', loading: 'lazy' }}
                     {{ section.settings.column_third_image_mob | image_url: width: 1040 | image_tag: class: 'meganav__img_mob', loading: 'lazy' }}
            </figure>
            <div class="mega-menu-one__content-box">
              <h2 class="mega-menu-one__container-title">{{ section.settings.column_title_third_title }}</h2>
              <p class="mega-menu-one__container-subtitle">{{ section.settings.column_title_third_subtitle }}</p>
              <a href="{{ section.settings.column_title_third_button_url }}" title="{{ section.settings.column_title_third_button_text }}">{{ section.settings.column_title_third_button_text }}</a>
            </div>
            </div>
          </div>
   </div>
</section>

{% comment %} <script src='{{ '' | asset_url }}' defer='defer'></script> {% endcomment %}

