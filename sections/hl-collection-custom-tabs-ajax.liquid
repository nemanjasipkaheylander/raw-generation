{% style %}
  #shopify-section-{{ section.id }} .collection-tab-buttons {
    display: flex;
    flex-wrap: wrap;
  }

  #shopify-section-{{ section.id }} .collection-tab-button {
    cursor: pointer;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .custom-popup__subtitle {
    display: block;
  }

  #shopify-section-{{ section.id }}.is-loading {
    pointer-events: none;
    opacity: 0.6;
    transition: opacity 0.2s ease;
  }
{% endstyle %}

<script>
  (function() {
    if (window.HLCollectionTabsBound) return;
    window.HLCollectionTabsBound = true;

    function getSectionRoot(sectionId) {
      return document.getElementById('shopify-section-' + sectionId);
    }

    function fetchAndSwapSection(url, sectionId, pushStateEnabled) {
      var sectionRoot = getSectionRoot(sectionId);
      if (!sectionRoot) return;

      sectionRoot.classList.add('is-loading');

      var requestUrl = url.indexOf('?') > -1
        ? url + '&section_id=' + sectionId
        : url + '?section_id=' + sectionId;

      fetch(requestUrl, {
        method: 'GET',
        headers: {
          'X-Requested-With': 'XMLHttpRequest'
        }
      })
        .then(function(response) {
          if (!response.ok) throw new Error('Failed to load collection section');
          return response.text();
        })
        .then(function(html) {
          var wrapper = document.createElement('div');
          wrapper.innerHTML = html;

          var incomingSection = wrapper.querySelector('#shopify-section-' + sectionId);
          if (!incomingSection) {
            incomingSection = wrapper.firstElementChild;
          }

          if (!incomingSection) throw new Error('Section markup not found');

          var currentSection = getSectionRoot(sectionId);
          if (!currentSection) return;

          currentSection.replaceWith(incomingSection);

          if (pushStateEnabled) {
            window.history.pushState({ sectionId: sectionId, url: url }, '', url);
          }

          window.HLCollectionTabsInit(sectionId);

          if (window.Shopify && window.Shopify.designMode) {
            document.dispatchEvent(new CustomEvent('shopify:section:load', {
              detail: { sectionId: sectionId }
            }));
          }
        })
        .catch(function(error) {
          console.error(error);
          window.location.href = url;
        });
    }

    window.HLCollectionTabsInit = function(sectionId) {
      var sectionRoot = getSectionRoot(sectionId);
      if (!sectionRoot) return;

      var links = sectionRoot.querySelectorAll('.collection-tab-button[data-collection-url]');

      links.forEach(function(link) {
        if (link.dataset.ajaxBound === 'true') return;
        link.dataset.ajaxBound = 'true';

        link.addEventListener('click', function(event) {
          if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
          event.preventDefault();

          var url = link.getAttribute('data-collection-url');
          if (!url) return;

          fetchAndSwapSection(url, sectionId, true);
        });
      });
    };

    document.addEventListener('DOMContentLoaded', function() {
      window.HLCollectionTabsInit('{{ section.id }}');
    });

    window.addEventListener('popstate', function() {
      var sectionRoot = getSectionRoot('{{ section.id }}');
      if (!sectionRoot) return;

      fetchAndSwapSection(window.location.pathname + window.location.search, '{{ section.id }}', false);
    });

    document.addEventListener('shopify:section:load', function(event) {
      if (event.detail && event.detail.sectionId === '{{ section.id }}') {
        window.HLCollectionTabsInit('{{ section.id }}');
      }
    });
  })();
</script>

