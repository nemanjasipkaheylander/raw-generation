


{{ '' | asset_url | stylesheet_tag }}

{% liquid
  assign section_target = section.settings.section_target
  assign bg_color = section.settings.bg_color
  assign bg_gradient_1 = section.settings.bg_gradient_1
  assign bg_gradient_2 = section.settings.bg_gradient_2
  assign padding_top = section.settings.padding_top
  assign padding_bottom = section.settings.padding_bottom
  assign padding_top_desk = section.settings.padding_top_desk
  assign padding_bottom_desk = section.settings.padding_bottom_desk
%}

{% style %}
  .{{ section.id }} {
    position: relative;
    background-color: {{ bg_color }};
    background-image: linear-gradient(to bottom, {{ bg_gradient_1 }} 0%, {{ bg_gradient_2 }} 100%);
    padding-top: {{ padding_top }}px;
    padding-bottom: {{ padding_bottom }}px;
  }
  @media (min-width: 768px) {
    .{{ section.id }} {
      padding-top: {{ padding_top_desk }}px;
      padding-bottom: {{ padding_bottom_desk }}px;
    }
  }
{% endstyle %}

<section class="{{ section.id }}" class="icon-text" id="{{ section_target }}">
    <div class="l">
      {% if section.settings.section_title_one != 'blank'  %}
         <div class="icon-text__title-container">
            <h2 class="title-icon-text">{{ section.settings.section_title_one }} <span class="purpple">{{ section.settings.section_title_two }}</span> <span>{{ section.settings.section_title_third }}</span></h2>
        </div>
      {% endif %}
      
          {% if section.blocks.size > 0 %}
              <div class="icon-text__container">
                 {% for block in section.blocks %}
                       <div class="icon-text__card">
                             <figure class="icon-text__image">
                                 {{ block.settings.icon_text_img | image_url: width: 320 | image_tag: class: 'it_icon', loading: 'lazy' }}
                             </figure>
                             <h2 class="icon-text__title">{{ block.settings.icon_text_title }}</h2>
                             <p class="icon-text__content">{{ block.settings.icon_text_content }}</p>
                       </div>
                 {% endfor %}
              </div>
          {% endif %}
    </div>
</section>

<style>
  .l {
      max-width: 1240px;
      margin: 0 auto;
      padding: 0 20px;
  }

  .icon-text__container {
      display: flex;
      gap: 24px;
      justify-content: center;
  }

  .icon-text__title-container {
      font-family: Jost;
      font-weight: 400;
      font-size: 40px;
      line-height: 140%;
      letter-spacing: 0%;
      text-align: center;
      margin-bottom: 48px;
  }

  .icon-text__image {
      max-width: 100px;
      margin-bottom: 24px;
  }

  .icon-text__title {
      font-family: Jost;
      font-weight: 600;
      font-size: 18px;
      line-height: 140%;
      letter-spacing: 0%;
      text-align: center;
      text-transform: uppercase;
      color: #000;
      margin-bottom: 8px;
  }

  .icon-text__content {
      font-family: Jost;
      font-weight: 400;
      font-size: 16px;
      line-height: 150%;
      letter-spacing: 0%;
      text-align: center;
      color: #000;
  }

  .icon-text__card {
      min-width: 282px;
      display: flex;
      flex-direction: column;
      align-items: center;
  }
  @media (max-width: 767px) {
    .icon-text__container {
      flex-direction: column;
    }
  }
</style>

{% comment %} <script src='{{ '' | asset_url }}' defer='defer'></script> {% endcomment %}

{% schema %}
  {
    "name": "Icon with text cards",
    "settings": [
      {
        "type": "header",
        "content": "Section Settings"
      },
      {
        "type": "text",
        "id": "section_target",
        "label": "Section Target"
      },
      {
        "type": "color",
        "id": "bg_color",
        "label": "Section background color"
      },
      {
        "type": "color",
        "id": "bg_gradient_1",
        "label": "Section gradient color first"
      }, {
        "type": "color",
        "id": "bg_gradient_2",
        "label": "Section gradient color second"
      },
      {
        "type": "text",
        "id": "padding_top",
        "label": "Section padding top - small screens"
      }, {
        "type": "text",
        "id": "padding_bottom",
        "label": "Section padding bottom - small screens"
      }, {
        "type": "text",
        "id": "padding_top_desk",
        "label": "Section padding top - large screens"
      }, {
        "type": "text",
        "id": "padding_bottom_desk",
        "label": "Section padding bottom - large screens"
      },
      {
        "type": "header",
        "content": "Section Content"
      },
      {
        "type": "text",
        "id": "section_title_one",
        "label": "Enter title first word"
      },
      {
        "type": "text",
        "id": "section_title_two",
        "label": "Enter title highlighted word"
      },
      {
        "type": "text",
        "id": "section_title_third",
        "label": "Enter title rest"
      }
    ],
    "blocks": [
        {
            "name": "icon-text",
            "type": "text",
            "settings": [ 
                        {
                            "type": "image_picker",
                            "id": "icon_text_img",
                            "label": "Upload icon"
                        },
                        {
                            "type": "text",
                            "id": "icon_text_title",
                            "label": "Enter title"
                        },
                        {
                            "type": "text",
                            "id": "icon_text_content",
                            "label": "Enter content"
                        }
            ]
        }
    ],
    "presets": [
      {
        "name": "Icon with text cards"
      }
    ]
  }
{% endschema %}