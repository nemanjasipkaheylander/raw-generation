                  <div class="collection__empty-grid-wrapper {{ grid_style }}-grid{% if disable_max_width %} disable-max-width{% endif %}">
                    <p class="collection__empty-message">No products found in this collection.</p>
                  </div>
                </div>
              {% endif %}
            </div>
          {% endfor %}
        {% else %}
          <div class="collection__empty-grid body-font side-margins">
            <div class="collection__empty-grid-wrapper {{ grid_style }}-grid{% if disable_max_width %} disable-max-width{% endif %}">
              <p class="collection__empty-message">Add tab blocks and assign collections.</p>
            </div>
          </div>
        {% endif %}

    <div class="hp-collection">
      <h3 class="hp-collection__title">{{ section.settings.custom_quiz }}</h3>
      {% if section.settings.custom_quiz_button_link %}
        <a href="{{ section.settings.custom_quiz_button_link }}" title="{{ section.settings.custom_quiz_button_text }}">
          {{ section.settings.custom_quiz_button_text }}
        </a>
      {% endif %}
    </div>
  </div>
</section>

<script>
  (function() {
    var sectionId = '{{ section.id }}';
    var sectionRoot = document.getElementById('shopify-section-' + sectionId);
    if (!sectionRoot) return;

    var nav = document.getElementById('CPProgramTabsNav-' + sectionId);
    if (!nav) return;

    var buttons = nav.querySelectorAll('[data-tab-target]');
    var panels = sectionRoot.querySelectorAll('[data-tab-panel]');

    function activateTab(tabId, button) {
      buttons.forEach(function(btn) {
        btn.classList.toggle('is-active', btn === button);
      });

      panels.forEach(function(panel) {
        var isActive = panel.getAttribute('data-tab-panel') === tabId;
        panel.hidden = !isActive;
        panel.classList.toggle('is-active', isActive);
      });
    }

    buttons.forEach(function(button) {
      button.addEventListener('click', function() {
        activateTab(button.getAttribute('data-tab-target'), button);
      });
    });
  })();
</script>

