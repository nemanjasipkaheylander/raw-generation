{{ '' | asset_url | stylesheet_tag }}

{% liquid
  assign section_target = section.settings.section_target
  assign bg_color = section.settings.bg_color
  assign bg_gradient_1 = section.settings.bg_gradient_1
  assign bg_gradient_2 = section.settings.bg_gradient_2
  assign padding_top = section.settings.padding_top
  assign padding_bottom = section.settings.padding_bottom
  assign padding_top_desk = section.settings.padding_top_desk
  assign padding_bottom_desk = section.settings.padding_bottom_desk
%}

{% style %}
  .{{ section.id }} {
    position: relative;
    background-color: {{ bg_color }};
    background-image: linear-gradient(to bottom, {{ bg_gradient_1 }} 0%, {{ bg_gradient_2 }} 100%);
    padding-top: {{ padding_top }}px;
    padding-bottom: {{ padding_bottom }}px;
    font-family: "Jost SemiBold", " sans-serif";
  }

  @media (min-width: 768px) {
    .{{ section.id }} {
      padding-top: {{ padding_top_desk }}px;
      padding-bottom: {{ padding_bottom_desk }}px;
    }
  }

  /* typography */
  .hl-hp-instagram__title,
  .hl-hp-instagram__title__subtitle {
    font-size: 40px;
    color: #fff;
    text-align: center;
  }

  .hl-hp-instagram__title__subtitle {
    margin-bottom: 7px;
  }

  /* social links */
  .hl-hp-instagram__social-wrapper {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 8px;
    margin-bottom: 32px;
    color: #fff;
  }

  .hl-hp-instagram__social-insta,
  .hl-hp-instagram__social-fb {
    display: flex;
    justify-content: center;
  }

  .hl-hp-instagram__social-wrapper a {
    text-transform: uppercase;
    font-weight: 600;
    font-size: 14px;
  }

  /* marquee */
  .hl-hp-instagram__marquee-wrapper {
    overflow: hidden;
    width: 100%;
  }

  .hl-hp-instagram__marquee-track {
    display: flex;
    gap: 12px;
    width: max-content;
    animation: marquee-left 80s linear infinite;
  }

  .hl-hp-instagram__marquee-track:hover {
    animation-play-state: paused;
  }

  /* image card */
  .hl-hp-instagram__image-container {
    position: relative;
    width: 140px;
    height: 140px;
    border-radius: 15px;
    overflow: hidden;
  }

  .hl-hp-instagram__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* hover overlay */
  .hl-hp-instagram__overlay {
    position: absolute;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .hl-hp-instagram__image-container:hover .hl-hp-instagram__overlay {
    opacity: 1;
  }

  /* desktop */
  @media (min-width: 600px) {
    .hl-hp-instagram__social-wrapper {
      flex-direction: row;
      gap: 70px;
      margin-bottom: 48px;
    }

    .hl-hp-instagram__social-wrapper a {
      font-size: 16px;
    }

    .hl-hp-instagram__image-container {
      width: 280px;
      height: 280px;
      border-radius: 20px;
    }

    .hl-hp-instagram__marquee-track {
      gap: 24px;
    }
  }

  @keyframes marquee-left {
    0%   { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
{% endstyle %}

<section class="{{ section.id }} hl-hp-instagram" id="{{ section_target }}">

    <h2 class="hl-hp-instagram__title">{{ section.settings.section_title }}</h2>
    <div class="hl-hp-instagram__title__subtitle">{{ section.settings.section_text }}</div>

    <div class="hl-hp-instagram__social-wrapper">
      <div class="hl-hp-instagram__social-insta">
        <a href="{{ section.settings.instagram_one_url }}" title="{{ section.settings.instagram_one_text }}">
          {{- section.settings.instagram_one_text -}}
        </a>
      </div>
      <div class="hl-hp-instagram__social-fb">
        <a href="{{ section.settings.instagram_two_url }}" title="{{ section.settings.instagram_two_text }}">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M15 1.66663H12.5C11.395 1.66663 10.3352 2.10561 9.55376 2.88701C8.77236 3.66842 8.33337 4.72822 8.33337 5.83329V8.33329H5.83337V11.6666H8.33337V18.3333H11.6667V11.6666H14.1667L15 8.33329H11.6667V5.83329C11.6667 5.61228 11.7545 5.40032 11.9108 5.24404C12.0671 5.08776 12.279 4.99996 12.5 4.99996H15V1.66663Z" fill="white"/>
          </svg>
          {{- section.settings.instagram_two_text -}}
        </a>
      </div>
    </div>

    {% if section.blocks.size > 0 %}
      <div class="hl-hp-instagram__marquee-wrapper">
        <div class="hl-hp-instagram__marquee-track">
          {% for i in (1..2) %}
            {% for block in section.blocks %}
              <div class="hl-hp-instagram__image-container">
                <a href="{{ block.settings.instagram_url }}" title="instagram-images">
                  {{
                    block.settings.instagram_img
                    | image_url: width: 600
                    | image_tag: class: 'hl-hp-instagram__img', loading: 'lazy'
                  }}
                  <div class="hl-hp-instagram__overlay">
                    <svg width="46" height="46" viewBox="0 0 46 46" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M12.7778 0C5.73211 0 0 5.73211 0 12.7778V33.2222C0 40.2679 5.73211 46 12.7778 46H33.2222C40.2679 46 46 40.2679 46 33.2222V12.7778C46 5.73211 40.2679 0 33.2222 0H12.7778ZM12.7778 5.11111H33.2222C37.4491 5.11111 40.8889 8.55089 40.8889 12.7778V33.2222C40.8889 37.4491 37.4491 40.8889 33.2222 40.8889H12.7778C8.55089 40.8889 5.11111 37.4491 5.11111 33.2222V12.7778C5.11111 8.55089 8.55089 5.11111 12.7778 5.11111ZM35.7778 7.66667C35.1 7.66667 34.45 7.93591 33.9707 8.41517C33.4915 8.89443 33.2222 9.54445 33.2222 10.2222C33.2222 10.9 33.4915 11.55 33.9707 12.0293C34.45 12.5085 35.1 12.7778 35.7778 12.7778C36.4556 12.7778 37.1056 12.5085 37.5848 12.0293C38.0641 11.55 38.3333 10.9 38.3333 10.2222C38.3333 9.54445 38.0641 8.89443 37.5848 8.41517C37.1056 7.93591 36.4556 7.66667 35.7778 7.66667ZM23 10.2222C15.9543 10.2222 10.2222 15.9543 10.2222 23C10.2222 30.0457 15.9543 35.7778 23 35.7778C30.0457 35.7778 35.7778 30.0457 35.7778 23C35.7778 15.9543 30.0457 10.2222 23 10.2222ZM23 15.3333C27.2269 15.3333 30.6667 18.7731 30.6667 23C30.6667 27.2269 27.2269 30.6667 23 30.6667C18.7731 30.6667 15.3333 27.2269 15.3333 23C15.3333 18.7731 18.7731 15.3333 23 15.3333Z" fill="white"/>
                    </svg>
                  </div>
                </a>
              </div>
            {% endfor %}
          {% endfor %}
        </div>
      </div>
    {% endif %}

</section>

{% schema %}
{
  "name": "Instagram section",
  "settings": [
    {
      "type": "header",
      "content": "Section Settings"
    },
    {
      "type": "text",
      "id": "section_target",
      "label": "Section Target"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section background color"
    },
    {
      "type": "color",
      "id": "bg_gradient_1",
      "label": "Section gradient color first"
    },
    {
      "type": "color",
      "id": "bg_gradient_2",
      "label": "Section gradient color second"
    },
    {
      "type": "text",
      "id": "padding_top",
      "label": "Section padding top - small screens"
    },
    {
      "type": "text",
      "id": "padding_bottom",
      "label": "Section padding bottom - small screens"
    },
    {
      "type": "text",
      "id": "padding_top_desk",
      "label": "Section padding top - large screens"
    },
    {
      "type": "text",
      "id": "padding_bottom_desk",
      "label": "Section padding bottom - large screens"
    },
    {
      "type": "header",
      "content": "Section Content"
    },
    {
      "type": "text",
      "id": "section_title",
      "label": "Enter title",
      "default": "Join Us On"
    },
    {
      "type": "richtext",
      "id": "section_text",
      "label": "Enter text"
    },
    {
      "type": "url",
      "id": "instagram_one_url",
      "label": "Paste url"
    },
    {
      "type": "text",
      "id": "instagram_one_text",
      "label": "Enter text"
    },
    {
      "type": "url",
      "id": "instagram_two_url",
      "label": "Paste url"
    },
    {
      "type": "text",
      "id": "instagram_two_text",
      "label": "Enter facebook text"
    }
  ],
  "blocks": [
    {
      "name": "instagram image",
      "type": "image",
      "settings": [
        {
          "type": "image_picker",
          "id": "instagram_img",
          "label": "Upload image"
        },
        {
          "type": "url",
          "id": "instagram_url",
          "label": "Paste url"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Instagram section"
    }
  ]
}
{% endschema %}