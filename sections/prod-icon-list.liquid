



{{ '' | asset_url | stylesheet_tag }}

{% liquid
  assign section_target = section.settings.section_target
  assign bg_color = section.settings.bg_color
  assign bg_gradient_1 = section.settings.bg_gradient_1
  assign bg_gradient_2 = section.settings.bg_gradient_2
  assign padding_top = section.settings.padding_top
  assign padding_bottom = section.settings.padding_bottom
  assign padding_top_desk = section.settings.padding_top_desk
  assign padding_bottom_desk = section.settings.padding_bottom_desk
%}

{% style %}
  .{{ section.id }} {
    position: relative;
    background-color: {{ bg_color }};
    background-image: linear-gradient(to bottom, {{ bg_gradient_1 }} 0%, {{ bg_gradient_2 }} 100%);
    padding-top: {{ padding_top }}px;
    padding-bottom: {{ padding_bottom }}px;
  }
  @media (min-width: 768px) {
    .{{ section.id }} {
      padding-top: {{ padding_top_desk }}px;
      padding-bottom: {{ padding_bottom_desk }}px;
    }
  }
{% endstyle %}

<section class="{{ section.id }}" class="icon-list" id="{{ section_target }}">
    <div class="l">
        <div class="icon-list__title-container">
            <h2 class="title-icon-list">{{ section.settings.section_title_one }} <span class="purpple">{{ section.settings.section_title_two }}</span> <span>{{ section.settings.section_title_third }}</span></h2>
        </div>
          {% if section.blocks.size > 0 %}
              <div class="icon-list__container">
                 {% for block in section.blocks %}
                       <div class="icon-list__card">
                             <figure class="icon-list__image">
                                 {{ block.settings.icon_list_img | image_url: width: 320 | image_tag: class: 'icon-list_img', loading: 'lazy' }}
                             </figure>
                             <h2 class="icon-list__title">{{ block.settings.icon_list_title }}</h2>
                             
                       </div>
                 {% endfor %}
              </div>
          {% endif %}
    </div>
</section>

<style>
.icon-list__container {
    display: grid;
    grid-template-columns: repeat(4, 1fr); /* Creates 4 equal columns */
    gap: 20px;
}

figure.icon-list__image {
    max-width: 60px;
}

.icon-list__card {
    display: flex;
    align-items: center;
    gap: 16px;
}

h2.title-icon-list {
    font-family: "Jost", sans-serif;
    font-weight: 400;
    font-size: 40px;
    line-height: 1.4;
    text-align: left;
    color: #000;
}

h2.title-icon-list .purpple {
    font-weight: 700;
    color: #a548d8;
}

.icon-list__title-container {margin-bottom: 48px;}

h2.icon-list__title {
    font-family: "Jost", sans-serif;
    font-weight: 500;
    font-size: 16px;
    line-height: 1.3;
    text-transform: uppercase;
    text-align: center;
    color: #000;
}

@media (max-width: 767px) {
  .icon-list__container {
    display: grid;
    grid-template-columns: repeat(2, 1fr); /* Creates 4 equal columns */
    gap: 20px;
}
h2.icon-list__title {
    font-size: 13px;
}
h2.title-icon-list {
    font-size: 28px;
}
.icon-list__title-container {margin-bottom: 32px;}

}
</style>

{% comment %} <script src='{{ '' | asset_url }}' defer='defer'></script> {% endcomment %}

{% schema %}
  {
    "name": "Icon list",
    "settings": [
      {
        "type": "header",
        "content": "Section Settings"
      },
      {
        "type": "text",
        "id": "section_target",
        "label": "Section Target"
      },
      {
        "type": "color",
        "id": "bg_color",
        "label": "Section background color"
      },
      {
        "type": "color",
        "id": "bg_gradient_1",
        "label": "Section gradient color first"
      }, {
        "type": "color",
        "id": "bg_gradient_2",
        "label": "Section gradient color second"
      },
      {
        "type": "text",
        "id": "padding_top",
        "label": "Section padding top - small screens"
      }, {
        "type": "text",
        "id": "padding_bottom",
        "label": "Section padding bottom - small screens"
      }, {
        "type": "text",
        "id": "padding_top_desk",
        "label": "Section padding top - large screens"
      }, {
        "type": "text",
        "id": "padding_bottom_desk",
        "label": "Section padding bottom - large screens"
      },
      {
        "type": "header",
        "content": "Section Content"
      },
      {
        "type": "text",
        "id": "section_title_one",
        "label": "Enter title first word"
      },
      {
        "type": "text",
        "id": "section_title_two",
        "label": "Enter title highlighted word"
      },
      {
        "type": "text",
        "id": "section_title_third",
        "label": "Enter title rest"
      }
    ],
    "blocks": [
        {
            "name": "icon-text",
            "type": "text",
            "settings": [ 
                        {
                            "type": "image_picker",
                            "id": "icon_list_img",
                            "label": "Upload icon"
                        },
                        {
                            "type": "text",
                            "id": "icon_list_title",
                            "label": "Enter title"
                        }
            ]
        }
    ],
    "presets": [
      {
        "name": "Icon list"
      }
    ]
  }
{% endschema %}