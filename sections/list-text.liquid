{{ 'list-text.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    padding-left: {{ section.settings.padding_left | times: 0.75 | round: 0 }}px;
    padding-right: {{ section.settings.padding_right | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
      padding-left: {{ section.settings.padding_left }}px;
      padding-right: {{ section.settings.padding_right }}px;
    }
  }
{%- endstyle -%}

<div id="{{- section.settings.redirect_section_id -}}">
  <div class="list-sec section-{{ section.id }}-padding">
    <div class="page-width">
      <h3 class="list-title">{{ section.settings.title }}</h3>
      {% if section.settings.subtitle %}
        <p class="center list-sub">{{ section.settings.subtitle }}</p>
      {% endif %}
      <div class="list">
        {% for block in section.blocks %}
          <div class="single-list">
            <div class="i-image">
              {%- liquid
                assign sizes = '40px'
                assign widths = '40, 80, 160'
              -%}
              {{
                block.settings['icon-image']
                | image_url: width: 80
                | image_tag: loading: 'lazy', width: '80', height: '80', sizes: sizes, widths: widths, class: 'icon-img'
              }}
            </div>
            <p class="l-text">{{ block.settings['list-text'] }}</p>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "List Text",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "redirect_section_id",
      "label": "Custom Section Id",
      "info": "This id will be used redirect/scroll to"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "What you can experience:"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "Left Padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_right",
      "label": "Right Padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "List Text",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon-image",
          "label": "Icon Image"
        },
        {
          "type": "text",
          "id": "list-text",
          "label": "List Text",
          "default": "Improve your gut health & eliminate bloating"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "List Text"
    }
  ]
}
{% endschema %}
