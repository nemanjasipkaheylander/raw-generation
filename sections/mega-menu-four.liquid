


{{ '' | asset_url | stylesheet_tag }}

{% liquid
  assign section_target = section.settings.section_target
  assign bg_color = section.settings.bg_color
  assign bg_gradient_1 = section.settings.bg_gradient_1
  assign bg_gradient_2 = section.settings.bg_gradient_2
  assign padding_top = section.settings.padding_top
  assign padding_bottom = section.settings.padding_bottom
  assign padding_top_desk = section.settings.padding_top_desk
  assign padding_bottom_desk = section.settings.padding_bottom_desk
%}

{% style %}
  .{{ section.id }} {
    position: relative;
    background-color: {{ bg_color }};
    background-image: linear-gradient(to bottom, {{ bg_gradient_1 }} 0%, {{ bg_gradient_2 }} 100%);
    padding-top: {{ padding_top }}px;
    padding-bottom: {{ padding_bottom }}px;
  }
  @media (min-width: 768px) {
    .{{ section.id }} {
      padding-top: {{ padding_top_desk }}px;
      padding-bottom: {{ padding_bottom_desk }}px;
    }
  }
{% endstyle %}

<section class="{{ section.id }} mega-menu-one" id="{{ section_target }}">
   <div class="l">
      {% if section.blocks.size > 0 %}
         <div class="mega-menu-one__container-one">
           {% for block in section.blocks %}
              <div class="mega-menu-one__product-card">
                  <div class="mega-menu-one__column_title">{{ section.settings.column_title_one }}</div>
                  <div class="mega-menu-one__product-label" style="background-color: {{ block.settings.mmo_label_color }};">{{ block.settings.mmo_label_text}}</div>
                  <a href="{{ block.settings.mmo_product }}" title="{{block.settings.mmo_product_title}}">
                  <figure class="mega-menu-one__product-image">
                     {{ block.settings.mmo_image | image_url: width: 320 | image_tag: class: 'meganav__gallery__img', loading: 'lazy' }}
                  </figure>
                  <h2 class="mega-menu-one__product-title">{{ block.settings.mmo_product_title}}</h2>
                  <p class="mega-menu-one__product-subtitle">{{ block.settings.mmo_product_subtitle}}</p>
                  </a>
              </div>
             
           {% endfor %}
          
           </div> 
      {% endif %}
       
   </div>
</section>

{% comment %} <script src='{{ '' | asset_url }}' defer='defer'></script> {% endcomment %}

{% schema %}
  {
    "name": "Mega menu Fourth link",
    "settings": [
      {
        "type": "header",
        "content": "Section Settings"
      },
      {
        "type": "text",
        "id": "section_target",
        "label": "Section Target"
      },
      {
        "type": "color",
        "id": "bg_color",
        "label": "Section background color"
      },
      {
        "type": "color",
        "id": "bg_gradient_1",
        "label": "Section gradient color first"
      }, {
        "type": "color",
        "id": "bg_gradient_2",
        "label": "Section gradient color second"
      },
      {
        "type": "text",
        "id": "padding_top",
        "label": "Section padding top - small screens"
      }, {
        "type": "text",
        "id": "padding_bottom",
        "label": "Section padding bottom - small screens"
      }, {
        "type": "text",
        "id": "padding_top_desk",
        "label": "Section padding top - large screens"
      }, {
        "type": "text",
        "id": "padding_bottom_desk",
        "label": "Section padding bottom - large screens"
      }
      ],
    "blocks": [
        {
            "name": "Product",
            "type": "product",
            "settings": [
                       {
                        "type": "url",
                        "id": "mmo_product",
                        "label": "paste link"
                       },
                       {
                        "type": "text",
                        "id": "mmo_label_text",
                        "label": "Enter  text"
                        },
                        {
                        "type": "color",
                        "id": "mmo_label_color",
                        "label": "Chose color"
                        },
                        {
                        "type": "text",
                        "id": "mmo_product_title",
                        "label": "Enter text"
                        },
                        {
                        "type": "text",
                        "id": "mmo_product_subtitle",
                        "label": "Enter text"
                        },
                        {
                        "type": "image_picker",
                        "id": "mmo_image",
                        "label": "Upload iamge"
                        }


            ]
        }
    ],
    "presets": [
      {
        "name": "Mega menu Fourth link"
      }
    ]
  }
{% endschema %}