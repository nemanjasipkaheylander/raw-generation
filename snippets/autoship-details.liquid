  This may or may not be needed
  Accepts:
  - extra_discount: {Boolean} Show extra discount message

  Usage:
  {% render 'autoship-details' %}
{% endcomment %}
<ul class="flex flex-col gap-2 px-3 py-4 text-sm list-none border">
