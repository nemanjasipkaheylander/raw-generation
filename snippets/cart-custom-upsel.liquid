{% assign product = all_products['metabolism-boost'] %}

<div class="product-card">
  {% if product.featured_image %}
    <div class="product-image">
      <img src="{{ product.featured_image | img_url: '300x' }}" alt="{{ product.title }}">
    </div>
  {% endif %}
  <div class="product-info">
    <h4>NUTRITIONIST RECOMMENDS</h4>
    <h2><a href="{{ product.url }}">{{ product.title }}</a></h2>
    <p>Supercharge your weight loss with Berberine, +30 fruits &amp; vegetables, and more.</p>
    
    <!-- ✅ Div button instead of form -->
    <div class="add-btn" data-variant-id="{{ product.selected_or_first_available_variant.id }}">
      ADD TO CART · {{ product.price | money }}
    </div>
  </div>
</div>

<style>
  .product-card {
    display: flex;
    align-items: stretch;
    background: #fff3db;
    border-radius: 10px;
    padding: 16px 20px;
    max-width: 550px;
    margin: 20px auto;
  }
  .product-image {
    width: 20%;
    display: flex;
    align-items: stretch;
  }
  .product-image img {
    height: 100%;
    width: auto;
    object-fit: cover;
    border-radius: 8px 0 0 8px;
  }
  .product-info {
    flex: 1;
    padding-left: 16px;
  }
  .product-info h4 {
    font-size: 12px;
    font-weight: 600;
    color: #7a5c45;
    margin: 0 0 6px;
    letter-spacing: 1px;
  }
  .product-info h2 {
    font-size: 18px;
    margin: 0 0 6px;
  }
  .product-info h2 a {
    text-decoration: underline;
    color: #000;
  }
  .product-info p {
    font-size: 14px;
    color: #444;
    margin: 0 0 14px;
    line-height: 1.4;
  }
  .add-btn {
    display: inline-block;
    padding: 10px 18px;
    border: 2px solid #000;
    border-radius: 6px;
    font-weight: 700;
    text-transform: uppercase;
    font-size: 14px;
    letter-spacing: 0.5px;
    background: #fff;
    cursor: pointer;
    transition: all 0.3s ease;
  }
  .add-btn:hover {
    background: #000;
    color: #fff;
  }
</style>


<script>
// ✅ AJAX Add to Cart with Alerts + Event Delegation
async function ajaxAddToCart(variantId, quantity = 1) {
  try {
    if (!variantId) {
    //  alert("❌ Variant ID missing!");
      return;
    }

    const res = await fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id: Number(variantId), quantity })
    });

    if (!res.ok) {
      const errorText = await res.text();
    //  alert("❌ Add to cart failed. Status: " + res.status + "\n" + errorText);
      throw new Error("Add to cart failed: " + res.status);
    }

    const data = await res.json();
    console.log("✅ Added to cart:", data);
   // alert("✅ Item added: " + data.title);

    // Refresh drawer
    await refreshCartDrawer();
  } catch (err) {
    console.error('Add to cart error:', err);
   // alert("❌ JS Error: " + err.message);
  }
}

// ✅ Event Delegation (always works, even for dynamically added buttons)
document.addEventListener("click", function(e) {
  const btn = e.target.closest(".add-btn");
  if (btn) {
    const variantId = btn.getAttribute("data-variant-id");
  //  alert("🟡 Trying to add Variant ID: " + variantId);
    ajaxAddToCart(variantId);
  }
});
</script>


