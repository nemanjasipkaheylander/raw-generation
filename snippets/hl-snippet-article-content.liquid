{% for art in artContent %}
    
        {% case art.type %}
            {% when 'article-heading' %}
                
            <div class="hl-article__hero-text">
                <h1 class="hl-article__title">
                    {{ article.title }}
                </h1>
                <div class="hl-article__info">
                    <div class="hl-article__date">{{ article.published_at | date: "%b %d, %Y" }}</div>
                    <div class="hl-article__rti">
                        <div class="hl-article__rti-icon"></div>
                        <div class="hl-article__rti-time">{{ article.metafields.custom.readtime }}</div>
                    </div>
                    <div class="hl-article__author-wrapper">
                        <div class="hl-article__author-image">
                            {{ article.metafields.custom.author_image | image_url: width: 2000 | image_tag: class: 'art-author__img', loading: 'lazy' }}
                        </div>
                        <div class="hl-article__author-name"><span class="random-text">Written by </span>{{ article.author }}</div>
                    </div>
                </div>

            </div>


                <div class="hl-article__image-wrapper">
                    <figure class="hl-article__feature-image">
                           {{ article.image | image_url: width: 2000 | image_tag: class: 'article__img', loading: 'lazy' }}  
                    </figure>
                    <div class="hl-article__caption">
                            {{ article.image.alt }}
                    </div>

                </div>
                                    <div class="hl-article__first-paragraph">
                        {{ art.settings.art_paragraph_one }}
                    </div>
             {% when 'hightlight-content' %}
                     <div class="hl-article__highlight-wrapper">
                         <div class="hl-article__highlight-header">
                              <figure class="hl-article__highlight-icon">
                                    {{ art.settings.hgh_icon | image_url: width: 2000 | image_tag: class: 'article__icon', loading: 'lazy' }}
                              </figure>
                              <h3 class="hl-article__highlight-title">
                                    {{ art.settings.hgh_title }}
                              </h3>

                              <div class="hl-article__highlight-content">
                                    {{ art.settings.hgh_content }}
                              </div>
                         </div>
                     </div>
                {% when 'paragraph' %}
                      <div class="hl-article__paragraph-wrapper" id="{{ art.settings.paragraph_anchor }}">
                            <h2 class="hl-article-title">
                                    {{ art.settings.paragraph_title }}
                              </h2>

                              <div class="hl-article__highlight-content">
                                    {{ art.settings.paragraph_content }}
                              </div>
                      </div>
                {% when 'quiz-devider' %}

                    <div class="hl-article__devider-quiz-card">
                            <div class='hl-article__wrapp'>
                        
                          <div class="hl-article__devider-name">
                            <div class="hl-article__devider-quiz-icon">
                                <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M9.1812 2.345C9.21691 2.15384 9.31835 1.98118 9.46795 1.85693C9.61755 1.73269 9.8059 1.66467 10.0004 1.66467C10.1948 1.66467 10.3832 1.73269 10.5328 1.85693C10.6824 1.98118 10.7838 2.15384 10.8195 2.345L11.6954 6.97667C11.7576 7.30596 11.9176 7.60885 12.1546 7.84581C12.3915 8.08277 12.6944 8.2428 13.0237 8.305L17.6554 9.18084C17.8465 9.21654 18.0192 9.31798 18.1434 9.46758C18.2677 9.61719 18.3357 9.80553 18.3357 10C18.3357 10.1945 18.2677 10.3828 18.1434 10.5324C18.0192 10.682 17.8465 10.7835 17.6554 10.8192L13.0237 11.695C12.6944 11.7572 12.3915 11.9172 12.1546 12.1542C11.9176 12.3912 11.7576 12.694 11.6954 13.0233L10.8195 17.655C10.7838 17.8462 10.6824 18.0188 10.5328 18.1431C10.3832 18.2673 10.1948 18.3353 10.0004 18.3353C9.8059 18.3353 9.61755 18.2673 9.46795 18.1431C9.31835 18.0188 9.21691 17.8462 9.1812 17.655L8.30537 13.0233C8.24316 12.694 8.08314 12.3912 7.84618 12.1542C7.60922 11.9172 7.30632 11.7572 6.97703 11.695L2.34537 10.8192C2.1542 10.7835 1.98155 10.682 1.8573 10.5324C1.73305 10.3828 1.66504 10.1945 1.66504 10C1.66504 9.80553 1.73305 9.61719 1.8573 9.46758C1.98155 9.31798 2.1542 9.21654 2.34537 9.18084L6.97703 8.305C7.30632 8.2428 7.60922 8.08277 7.84618 7.84581C8.08314 7.60885 8.24316 7.30596 8.30537 6.97667L9.1812 2.345Z" stroke="#A200F9" stroke-linecap="round" stroke-linejoin="round"/>
                                    <path d="M16.667 1.66663V4.99996" stroke="#A200F9" stroke-linecap="round" stroke-linejoin="round"/>
                                    <path d="M18.3333 3.33337H15" stroke="#A200F9" stroke-linecap="round" stroke-linejoin="round"/>
                                    <path d="M3.33366 18.3333C4.25413 18.3333 5.00033 17.5871 5.00033 16.6667C5.00033 15.7462 4.25413 15 3.33366 15C2.41318 15 1.66699 15.7462 1.66699 16.6667C1.66699 17.5871 2.41318 18.3333 3.33366 18.3333Z" stroke="#A200F9" stroke-linecap="round" stroke-linejoin="round"/>
                                    </svg>

                            </div>
                            <span class="hl-article__devider-quiz-tagline">{{ art.settings.qzd_tagline}}</span>
                            </div>
                            <div class="hl-article__devider-quiz-title">{{ art.settings.qzd_title }}</div>
                            <div class="hl-article__devider-quiz-contnet">{{ art.settings.qzd_content}}</div>
                          {% if art.settings.qzd_url %}
                                <a href="{{ art.settings.qzd_url }}" title="{{ art.settings.qzd_button_text }}" class='hl-article__quiz-btn'>
                                  {{ art.settings.qzd_button_text}}
                                </a>
                          {% endif %}
                    </div>

                          <div class="hl-article-quiz-devider-image">
                              <figure class="hl-article__devider-quiz-image">
                               {{ art.settings.qzd_image | image_url: width: 2000 | image_tag: class: 'art-author__img', loading: 'lazy' }}
                          </figure>
                          
                        </div>
                    </div>
                      
        {% endcase %}
{% endfor %}